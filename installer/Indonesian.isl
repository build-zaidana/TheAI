; Indonesian for the TheAI installer: the wizard's main screens. Loaded on top of Inno Setup's
; Default.isl (MessagesFile: "compiler:Default.isl,Indonesian.isl"), so anything not translated
; here stays English instead of failing.

[LangOptions]
LanguageName=Bahasa Indonesia
LanguageID=$0421
LanguageCodePage=0

[Messages]
SetupAppTitle=Pemasangan
SetupWindowTitle=Pemasangan - %1
UninstallAppTitle=Pencopotan
UninstallAppFullTitle=Pencopotan %1

ButtonBack=< &Kembali
ButtonNext=&Lanjut >
ButtonInstall=&Pasang
ButtonOK=OK
ButtonCancel=Batal
ButtonYes=&Ya
ButtonNo=&Tidak
ButtonFinish=&Selesai
ButtonBrowse=&Telusuri...
ButtonWizardBrowse=T&elusuri...
ButtonNewFolder=&Buat folder baru

ExitSetupTitle=Keluar dari pemasangan
ExitSetupMessage=Pemasangan belum selesai. Kalau keluar sekarang, program tidak akan terpasang.%n%nKamu bisa menjalankan pemasangan lagi nanti.%n%nKeluar dari pemasangan?

WelcomeLabel1=Selamat datang di pemasangan [name]
WelcomeLabel2=Ini akan memasang [name/ver] di komputermu.%n%nSebaiknya tutup aplikasi lain sebelum melanjutkan.

WizardSelectDir=Pilih lokasi pemasangan
SelectDirDesc=Di mana [name] akan dipasang?
SelectDirLabel3=[name] akan dipasang di folder berikut.
SelectDirBrowseLabel=Klik Lanjut untuk melanjutkan. Untuk memilih folder lain, klik Telusuri.

WizardSelectTasks=Pilih tugas tambahan
SelectTasksDesc=Tugas tambahan apa yang perlu dijalankan?
SelectTasksLabel2=Pilih tugas tambahan yang ingin dijalankan saat memasang [name], lalu klik Lanjut.

WizardReady=Siap memasang
ReadyLabel1=[name] siap dipasang di komputermu.
ReadyLabel2a=Klik Pasang untuk mulai, atau Kembali untuk meninjau atau mengubah pengaturan.
ReadyLabel2b=Klik Pasang untuk mulai.
ReadyMemoDir=Lokasi tujuan:
ReadyMemoTasks=Tugas tambahan:

WizardPreparing=Bersiap memasang
PreparingDesc=Bersiap memasang [name] di komputermu.
ApplicationsFound=Aplikasi berikut memakai file yang perlu diperbarui. Sebaiknya izinkan pemasangan menutupnya secara otomatis.
CloseApplications=&Tutup aplikasi secara otomatis
DontCloseApplications=&Jangan tutup aplikasi

WizardInstalling=Memasang
InstallingLabel=Tunggu sebentar, [name] sedang dipasang di komputermu.

FinishedHeadingLabel=Pemasangan [name] selesai
FinishedLabelNoIcons=[name] sudah terpasang di komputermu.
FinishedLabel=[name] sudah terpasang di komputermu. Aplikasinya bisa dibuka lewat pintasan yang dipasang.
ClickFinish=Klik Selesai untuk menutup pemasangan.
RunEntryExec=Jalankan %1

ConfirmUninstall=Yakin ingin mencopot %1 beserta semua komponennya?
UninstallStatusLabel=Tunggu sebentar, %1 sedang dicopot dari komputermu.
UninstalledAll=%1 berhasil dicopot dari komputermu.
