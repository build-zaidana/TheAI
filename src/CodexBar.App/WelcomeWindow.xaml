<Window x:Class="CodexBar.App.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CodexBar.App"
        Title="{local:Tr Selamat datang di TheAI, En=Welcome to TheAI}"
        Width="620" Height="720"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen" ShowInTaskbar="True"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14" Foreground="{DynamicResource FluentText}"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="FluentTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border Margin="22" CornerRadius="8" Background="{DynamicResource FluentWindow}" BorderBrush="{DynamicResource FluentEdge}" BorderThickness="1"
            MouseLeftButtonDown="Window_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.22" Direction="270" />
        </Border.Effect>
        <Grid>
        <Grid Margin="32,24,32,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Step 1: what the notch is and the three things to know. -->
            <StackPanel x:Name="TourStep">
                <!-- The reason to install, shown first: an agent asking, answered from the notch. -->
                <Border Height="240" Margin="-32,-24,-32,0" CornerRadius="8,8,0,0" Background="#141416">
                    <Border Width="388" Height="216" VerticalAlignment="Top" CornerRadius="0,0,36,36" Background="Black" Padding="16">
                        <StackPanel>
                            <Grid Height="18">
                                <TextBlock Text="{local:Tr Claude Code minta izin, En=Claude Code needs permission}" FontSize="13" FontWeight="Medium" Foreground="#98989F" />
                                <TextBlock Text="api" FontSize="13" FontWeight="Medium" Foreground="#98989F" HorizontalAlignment="Right" />
                            </Grid>
                            <TextBlock Margin="-1,4,0,0" Text="{local:Tr Jalankan perintah?, En=Run this command?}" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="30" LineHeight="40" Foreground="#F5F5F7" />
                            <Border Margin="0,8,0,0" Height="40" CornerRadius="16" Background="#1C1C1E" Padding="12,0">
                                <TextBlock Text="npm install --save-dev vitest" FontFamily="Cascadia Mono, Consolas" FontSize="13" Foreground="#F5F5F7" VerticalAlignment="Center" />
                            </Border>
                            <UniformGrid Rows="1" Margin="0,16,-8,0">
                                <Border Height="40" CornerRadius="20" Background="#1C1C1E" Margin="0,0,8,0">
                                    <TextBlock Text="{local:Tr Tolak, En=Decline}" FontWeight="SemiBold" Foreground="#F5F5F7" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <Border Height="40" CornerRadius="20" Background="#F5F5F7" Margin="0,0,8,0">
                                    <TextBlock Text="{local:Tr Izinkan sekali, En=Allow once}" FontWeight="SemiBold" Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                </Border>
                <TextBlock Margin="0,24,0,0" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="28" LineHeight="36" FontWeight="SemiBold"
                           Text="{local:Tr Setujui agent-mu dari notch, En=Approve your agents from the notch}" />
                <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource FluentText2}" TextWrapping="Wrap" FontSize="14" LineHeight="20"
                           Text="{local:Tr Mereka bekerja di latar belakang dan bertanya di sini saat butuh kamu. Tiga hal yang perlu kamu tahu:, En=They work in the background and ask here when they need you. Three things to know:}" />

                <StackPanel x:Name="Tips" Margin="0,16,0,0" />
            </StackPanel>

            <!-- Step 2: pick what the notch does. -->
            <DockPanel x:Name="FeatureStep" Visibility="Collapsed">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="28" LineHeight="36" FontWeight="SemiBold" Margin="0,0,40,0" Text="{local:Tr Pilih yang kamu mau di notch, En=Choose what the notch shows}" />
                    <TextBlock Margin="0,6,0,12" Foreground="{DynamicResource FluentText2}" TextWrapping="Wrap" FontSize="14" LineHeight="20"
                               Text="{local:Tr Semuanya opsional dan bisa diubah kapan saja di Pengaturan → Tampilan → Pilih fitur., En=Everything is optional and can be changed any time in Settings → Appearance → Choose features.}" />
                    <!-- What the feature under the pointer (or the keyboard) looks like in the notch. -->
                    <Border x:Name="PreviewPane" Height="150" CornerRadius="4" Margin="0,0,0,16" ClipToBounds="True" Background="#141416">
                        <Grid>
                            <Image x:Name="PreviewImage" Stretch="Uniform" StretchDirection="DownOnly" VerticalAlignment="Top" Margin="0,0,0,26"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                            <TextBlock x:Name="PreviewCaption" Foreground="#E6FFFFFF" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                       Margin="12,0,12,7" TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Border>
                </StackPanel>
                <!-- One click to a sensible set; each switch below still changes it. -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="{local:Tr Mulai dari:, En=Start from:}" Foreground="{DynamicResource FluentText2}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Button x:Name="PresetMinimal" Style="{StaticResource FluentButton}" Margin="0,0,8,0" Click="Preset_Click" Tag="minimal"
                            Content="{local:Tr Minimal, En=Minimal}" />
                    <Button x:Name="PresetSuggested" Style="{StaticResource FluentButton}" Margin="0,0,8,0" Click="Preset_Click" Tag="suggested"
                            Content="{local:Tr Disarankan, En=Recommended}" />
                    <Button x:Name="PresetAll" Style="{StaticResource FluentButton}" Click="Preset_Click" Tag="all"
                            Content="{local:Tr Semua, En=Everything}" />
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                    <StackPanel x:Name="FeatureGroups" Margin="0,0,4,0" />
                </ScrollViewer>
            </DockPanel>

            <Grid Grid.Row="1" Margin="0,16,0,0">
                <StackPanel x:Name="StepDots" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="Dot1" Width="6" Height="6" Fill="{DynamicResource FluentText}" Margin="0,0,6,0" />
                    <Ellipse x:Name="Dot2" Width="6" Height="6" Fill="{DynamicResource FluentDotOff}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BackButton" Style="{StaticResource FluentButton}" Content="{local:Tr Kembali, En=Back}" Margin="0,0,8,0"
                            Visibility="Collapsed" Click="Back_Click" />
                    <Button x:Name="NextButton" Style="{StaticResource FluentPrimaryButton}" Content="{local:Tr Lanjut, En=Continue}" IsDefault="True" Click="Next_Click" />
                </StackPanel>
            </Grid>
        </Grid>
        <Button x:Name="CloseCaption" Style="{StaticResource FluentCaptionClose}" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Top"
                Click="Close_Click" ToolTip="{local:Tr Tutup, En=Close}" AutomationProperties.Name="{local:Tr Tutup, En=Close}" />
        </Grid>
    </Border>
</Window>
