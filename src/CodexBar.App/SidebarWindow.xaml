<Window x:Class="CodexBar.App.SidebarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Codex"
        AutomationProperties.Name="Menu dan riwayat Codex"
        Width="344"
        Height="620"
        MinWidth="300"
        MinHeight="360"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Transparent"
        AllowsTransparency="True"
        KeyboardNavigation.TabNavigation="Cycle"
        Loaded="Window_Loaded">

    <Window.Resources>
        <SolidColorBrush x:Key="PanelBackground" Color="Transparent" />
        <SolidColorBrush x:Key="CardBackground" Color="#12FFFFFF" />
        <SolidColorBrush x:Key="PrimaryText" Color="#1B2230" />
        <SolidColorBrush x:Key="MutedText" Color="#586275" />
        <Style x:Key="QuietButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource MutedText}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder"
            CornerRadius="8"
            BorderThickness="1"
            BorderBrush="#33FFFFFF"
            Background="{DynamicResource PanelBackground}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="14,0,8,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="24" Height="24" CornerRadius="7" Background="#2F7BF6" Margin="0,0,9,0">
                        <TextBlock Text="C" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Codex" Foreground="{DynamicResource PrimaryText}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <Button x:Name="SidebarCloseButton" Grid.Column="1" Content="×" FontSize="19" Style="{StaticResource QuietButton}" Click="CloseButton_Click" ToolTip="Tutup menu" AutomationProperties.Name="Tutup daftar thread" />
            </Grid>

            <Border Grid.Row="1" Margin="12,0,12,10" Padding="11" CornerRadius="10" Background="{DynamicResource CardBackground}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Ellipse x:Name="AccountDot" Width="9" Height="9" Fill="#768091" Margin="0,2,10,0" VerticalAlignment="Top" />
                    <StackPanel Grid.Column="1">
                        <TextBlock x:Name="AccountNameText" Text="Memeriksa akun…" Foreground="{DynamicResource PrimaryText}" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="AccountPlanText" Text="Codex" Foreground="{DynamicResource MutedText}" FontSize="11" Margin="0,3,0,0" />
                    </StackPanel>
                    <Button x:Name="SidebarRefreshButton" Grid.Column="2" Content="↻" FontSize="16" Style="{StaticResource QuietButton}" Click="RefreshButton_Click" ToolTip="Muat ulang" AutomationProperties.Name="Muat ulang akun dan thread" />
                </Grid>
            </Border>

            <Button x:Name="NewThreadButton" Grid.Row="2"
                    Margin="12,2,12,10"
                    Height="40"
                    Content="＋  Percakapan baru"
                    FontWeight="SemiBold"
                    Style="{StaticResource AccentButton}"
                    Click="NewThreadButton_Click" AutomationProperties.Name="Buat percakapan baru" />

            <Border Grid.Row="3" Margin="12,0,12,9" CornerRadius="10" Background="#0CFFFFFF" BorderBrush="#2EFFFFFF" BorderThickness="1">
                <TextBox x:Name="SearchBox"
                         Height="36"
                         Padding="10,7"
                         Background="Transparent"
                         Foreground="{DynamicResource PrimaryText}"
                         BorderThickness="0"
                         CaretBrush="#1B2230"
                         TextChanged="SearchBox_TextChanged"
                         ToolTip="Cari percakapan"
                         AutomationProperties.Name="Cari percakapan Codex"
                         Tag="Cari percakapan" />
            </Border>

            <Grid Grid.Row="4" Margin="6,0,6,0">
                <ListBox x:Name="ThreadList"
                         AutomationProperties.Name="Daftar percakapan Codex"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="{DynamicResource PrimaryText}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="ThreadList_SelectionChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,1" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="10,8" CornerRadius="8" Background="Transparent"
                                    AutomationProperties.Name="{Binding Title}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" Foreground="{DynamicResource PrimaryText}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding WorkspaceName}" Foreground="{DynamicResource MutedText}" FontSize="10" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Text="{Binding StatusLabel}" Foreground="{Binding StatusBrush}" FontSize="10" FontWeight="SemiBold" Margin="8,0,0,0" />
                                        <TextBlock Grid.Column="2" Text="{Binding UpdatedLabel}" Foreground="{DynamicResource MutedText}" FontSize="10" Margin="8,0,0,0" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock x:Name="EmptyText"
                           Text="Belum ada percakapan"
                           Foreground="{DynamicResource MutedText}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="Collapsed" />
            </Grid>

            <TextBlock x:Name="FooterText"
                       Grid.Row="5"
                       Text="Riwayat lokal Codex"
                       Foreground="{DynamicResource MutedText}"
                       FontSize="10"
                       Margin="16,8,16,12"
                       TextTrimming="CharacterEllipsis" />
        </Grid>
    </Border>
</Window>
