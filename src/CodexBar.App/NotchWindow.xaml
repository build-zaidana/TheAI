<Window x:Class="CodexBar.App.NotchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CodexBar.App"
        Title="TheAI Notch"
        AutomationProperties.Name="TheAI notch"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Width="900"
        Height="640"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="13"
        Foreground="White"
        Deactivated="Window_Deactivated"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <!-- Tooltips that match the black chat/notch: dark, rounded, small text. -->
        <Style TargetType="ToolTip">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="HasDropShadow" Value="False" />
            <Setter Property="Placement" Value="Bottom" />
            <Setter Property="VerticalOffset" Value="6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="#F21C1C1E" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="7" Padding="9,5,9,6">
                            <ContentPresenter TextElement.Foreground="#F5F5F7" TextElement.FontSize="12"
                                              TextElement.FontFamily="Segoe UI Variable Text, Segoe UI" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <SolidColorBrush x:Key="NotchText" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="NotchText2" Color="#BFFFFFFF" />
        <SolidColorBrush x:Key="NotchText3" Color="#80FFFFFF" />
        <SolidColorBrush x:Key="NotchFill" Color="#1AFFFFFF" />
        <SolidColorBrush x:Key="NotchFillHover" Color="#24FFFFFF" />
        <SolidColorBrush x:Key="NotchAccent" Color="#0A84FF" />
        <SolidColorBrush x:Key="NotchGreen" Color="#30D158" />
        <SolidColorBrush x:Key="NotchOrange" Color="#FF9F0A" />
        <SolidColorBrush x:Key="NotchRed" Color="#FF453A" />

        <Style x:Key="NotchIconButton" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Foreground" Value="{StaticResource NotchText2}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource NotchFill}" />
                                <Setter Property="Foreground" Value="{StaticResource NotchText}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NotchRowButton" TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{StaticResource NotchText2}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="10" Padding="12,0">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource NotchFill}" />
                                <Setter Property="Foreground" Value="{StaticResource NotchText}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource NotchFill}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NotchChip" TargetType="Button">
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Foreground" Value="{StaticResource NotchText2}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="#14FFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="0.5" CornerRadius="14" Padding="12,0">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource NotchFillHover}" />
                                <Setter Property="Foreground" Value="{StaticResource NotchText}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NotchRoundButton" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="White" CornerRadius="99">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#E6FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Background" Value="#40FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NotchProviderButton" TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="#14FFFFFF" CornerRadius="12" Padding="9,0,10,0">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#26FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NotchGrabber" TargetType="Button">
            <Setter Property="Width" Value="72" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Border x:Name="Bar" Width="36" Height="5" CornerRadius="2.5" Background="#47FFFFFF" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bar" Property="Background" Value="#80FFFFFF" />
                                <Setter TargetName="Bar" Property="Width" Value="44" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NotchInput" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="CaretBrush" Value="White" />
            <Setter Property="SelectionBrush" Value="#0A84FF" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Request view (approvals / agent questions) -->
        <!-- Island buttons (Page 2, board 00): 40 tall, R 20, so in a corner at P 16 they sit concentric with RE 36. -->
        <Style x:Key="IslandButton" TargetType="Button">
            <Setter Property="Height" Value="40" />
            <Setter Property="Foreground" Value="#F5F5F7" />
            <Setter Property="Background" Value="#1C1C1E" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="20" Padding="16,0">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.86" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="IslandChip" TargetType="Button">
            <Setter Property="Height" Value="28" />
            <Setter Property="Foreground" Value="#F5F5F7" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="#1C1C1E" CornerRadius="14" Padding="12,0">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#2C2C2E" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="IslandPrimaryButton" TargetType="Button" BasedOn="{StaticResource IslandButton}">
            <Setter Property="Foreground" Value="Black" />
            <Setter Property="Background" Value="#F5F5F7" />
        </Style>
        <Style x:Key="IslandRoundButton" TargetType="Button" BasedOn="{StaticResource IslandButton}">
            <Setter Property="Width" Value="40" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="20">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.86" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NotchPill" TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="#1FFFFFFF" CornerRadius="16" Padding="16,0">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#33FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NotchPrimaryPill" TargetType="Button" BasedOn="{StaticResource NotchPill}">
            <Setter Property="Foreground" Value="Black" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="White" CornerRadius="16" Padding="16,0">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#E6FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NotchTextLink" TargetType="Button">
            <Setter Property="Foreground" Value="#99FFFFFF" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter VerticalAlignment="Center" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NotchOption" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="#D9FFFFFF" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bg" Background="#14FFFFFF" BorderBrush="Transparent" BorderThickness="1.5" CornerRadius="12" Padding="12,8">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1FFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="White" />
                                <Setter TargetName="Bg" Property="Background" Value="#24FFFFFF" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NotchSecret" TargetType="PasswordBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="CaretBrush" Value="White" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Timer page: thin display digits, tinted round buttons, quiet text buttons, length tiles. -->
        <!-- Sora (SIL Open Font License, Fonts/OFL.txt): the timer's digits and labels. -->
        <!-- Numbers and titles: Segoe UI Variable Display, Windows' closest match to SF (Page 2's Inter). -->
        <FontFamily x:Key="SoraFont">Segoe UI Variable Display, Segoe UI</FontFamily>

        <Style x:Key="NotchDigits" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource SoraFont}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="44" />
            <Setter Property="Foreground" Value="#F5F5F7" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="NotchLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource SoraFont}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="#F5F5F7" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- One family (boards 31-34): label 13/18, hero 60/64 thin or title 30/40, footer 12/16 over 14/20. -->
        <Style x:Key="IslandMeta" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Height" Value="18" />
            <Setter Property="LineHeight" Value="18" />
            <Setter Property="Foreground" Value="#98989F" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="IslandHero" TargetType="TextBlock" BasedOn="{StaticResource NotchDigits}">
            <Setter Property="FontSize" Value="60" />
            <Setter Property="FontWeight" Value="Light" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Margin" Value="-3,-12,0,-12" />
        </Style>
        <Style x:Key="IslandHeroUnit" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="#98989F" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="Margin" Value="4,0,0,12" />
        </Style>
        <Style x:Key="IslandTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource SoraFont}" />
            <Setter Property="FontSize" Value="30" />
            <Setter Property="FontWeight" Value="Light" />
            <Setter Property="LineHeight" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Foreground" Value="#F5F5F7" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="IslandFootLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="LineHeight" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Opacity" Value="0.8" />
        </Style>
        <Style x:Key="IslandFootValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="LineHeight" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        </Style>
        <Style x:Key="IslandFootButton" TargetType="Button">
            <Setter Property="Foreground" Value="#98989F" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Tag" Value="selected">
                    <Setter Property="Foreground" Value="#F5F5F7" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#F5F5F7" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Timer modes as chips (Page 2, board 06): 28 tall, R 14, surface/1; the chosen one is white. -->

        <Style x:Key="NotchTintButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse Fill="{TemplateBinding Background}" />
                            <Ellipse x:Name="Hover" Fill="White" Opacity="0" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hover" Property="Opacity" Value="0.08" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Hover" Property="Opacity" Value="0.16" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <Style x:Key="NotchTextButton" TargetType="Button">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="#8CFFFFFF" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="8" Padding="10,6">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource NotchFill}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!-- An alarm clock in the timer's orange: bells, legs, a round face with its hands. -->
        <Viewbox x:Key="NotchAlarmGlyph" x:Shared="False" Stretch="Uniform">
            <Canvas Width="28" Height="28">
                <Path Fill="#F5F5F7" Data="M 2.2,9.4 A 5.4,5.4 0 0 1 9.4,2.2 Z M 25.8,9.4 A 5.4,5.4 0 0 0 18.6,2.2 Z" />
                <Path Stroke="#F5F5F7" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Data="M 8.2,22.6 L 5.6,25.6 M 19.8,22.6 L 22.4,25.6" />
                <Ellipse Fill="#F5F5F7" Width="21" Height="21" Canvas.Left="3.5" Canvas.Top="5" />
                <Path Stroke="Black" StrokeThickness="2.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      Data="M 14,9.8 L 14,15.5 L 18,15.5" />
            </Canvas>
        </Viewbox>
    </Window.Resources>

    <!-- Transparent margin gives the drop shadow room; transparent pixels are click-through. -->
    <Grid>
    <!-- Gooey liquid drawn while the compact notch is being dragged (see NotchWindow.Liquid.cs). -->
    <Image x:Name="LiquidImage" Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Top"
           IsHitTestVisible="False" Visibility="Collapsed" RenderOptions.BitmapScalingMode="NearestNeighbor" />
    <Grid x:Name="Root" Margin="28,0,28,36">
        <!-- Time's up: rings spreading out from under the notch (behind it). -->
        <Grid x:Name="TimerRipples" HorizontalAlignment="Center" VerticalAlignment="Top" Width="1" Height="1"
              IsHitTestVisible="False" Visibility="Collapsed">
            <Ellipse x:Name="TimerRipple1" Width="120" Height="120" Margin="-60" Stroke="#F5F5F7" StrokeThickness="2" RenderTransformOrigin="0.5,0.5" Opacity="0">
                <Ellipse.RenderTransform><ScaleTransform /></Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse x:Name="TimerRipple2" Width="120" Height="120" Margin="-60" Stroke="#F5F5F7" StrokeThickness="2" RenderTransformOrigin="0.5,0.5" Opacity="0">
                <Ellipse.RenderTransform><ScaleTransform /></Ellipse.RenderTransform>
            </Ellipse>
        </Grid>
        <Border x:Name="Shell"
                Background="Black"
                AllowDrop="True"
                DragEnter="Shell_DragEnter"
                DragOver="Shell_DragOver"
                DragLeave="Shell_DragLeave"
                Drop="Shell_Drop"
                CornerRadius="0,0,14,14"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                MouseEnter="Shell_MouseEnter"
                MouseLeave="Shell_MouseLeave"
                PreviewMouseWheel="Shell_PreviewMouseWheel"
                MouseLeftButtonDown="Shell_MouseLeftButtonDown"
                MouseMove="Shell_MouseMove"
                MouseLeftButtonUp="Shell_MouseLeftButtonUp">

            <Grid x:Name="ShellRoot">
            <!-- The live object (record, dial, orb) leaving the island's left side, and the neck joining it:
                 above the island's black, below the panels, and free to draw outside the Shell (NotchWindow.LiveObject.cs). -->
            <Canvas x:Name="ObjectLayer" IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top" />
            <!-- Corner-docked L shape (Border background is cleared in corner mode). -->
            <local:NotchShape x:Name="CornerShape" Visibility="Collapsed" />
            <!-- The panels are clipped here (the Shell no longer clips, so the live object can leave it). -->
            <local:UnclampedGrid x:Name="PanelHost" ClipToBounds="True">
                <!-- Compact: icon only, like a hardware notch with a live activity. -->
                <Grid x:Name="CompactPanel" Height="32" Margin="11,0" Cursor="Hand" VerticalAlignment="Top"
                      MouseEnter="CompactPanel_MouseEnter" MouseLeave="CompactPanel_MouseLeave"
                      Background="Transparent"
                      AutomationProperties.Name="Buka TheAI">
                    <Border x:Name="CompactGlyph" Width="13" Height="13" CornerRadius="3.5" Background="White"
                            HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed">
                        <Border Width="7" Height="2.5" CornerRadius="0,0,1.5,1.5" Background="Black" VerticalAlignment="Top" />
                    </Border>
                    <!-- What is playing (Windows media controls): the album art takes the logo's place. -->
                    <Border x:Name="CompactArt" Width="18" Height="18" CornerRadius="4" Background="{StaticResource NotchFill}"
                            HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False" />
                    <!-- The notch's timer: a progress ring (plus the time when an agent holds the right side). -->
                    <StackPanel x:Name="CompactTimer" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center"
                                Visibility="Collapsed" IsHitTestVisible="False">
                        <Grid x:Name="CompactTimerRing" Width="16" Height="16" VerticalAlignment="Center">
                            <Ellipse x:Name="CompactTimerTrack" Stroke="#38FFFFFF" StrokeThickness="2.2" />
                            <Path x:Name="CompactTimerArc" Stroke="#F5F5F7" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Grid>
                        <ContentControl x:Name="CompactAlarmGlyph" Content="{StaticResource NotchAlarmGlyph}" Width="17" Height="17"
                                        VerticalAlignment="Center" Visibility="Collapsed" />
                        <TextBlock x:Name="CompactTimerLeftText" FontFamily="{StaticResource SoraFont}" Margin="6,0,0,0" FontSize="13" VerticalAlignment="Center"
                                   Typography.NumeralAlignment="Tabular" Foreground="#F5F5F7" Visibility="Collapsed" />
                    </StackPanel>
                    <TextBlock x:Name="CompactTimerText" FontFamily="{StaticResource SoraFont}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="13"
                               Typography.NumeralAlignment="Tabular" Foreground="#F5F5F7" Visibility="Collapsed" IsHitTestVisible="False" />
                    <!-- An event about to start: a calendar and the minutes left. -->
                    <Path x:Name="CompactCalendar" Stroke="#F5F5F7" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed"
                          IsHitTestVisible="False" Data="M 1.5,4.5 Q 1.5,2.5 3.5,2.5 L 12.5,2.5 Q 14.5,2.5 14.5,4.5 L 14.5,12.5 Q 14.5,14.5 12.5,14.5 L 3.5,14.5 Q 1.5,14.5 1.5,12.5 Z M 1.5,6 L 14.5,6 M 5,1 L 5,4 M 11,1 L 11,4" />
                    <TextBlock x:Name="CompactCalendarText" FontFamily="{StaticResource SoraFont}" FontSize="13" Foreground="#F5F5F7" HorizontalAlignment="Right"
                               VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False" />
                    <!-- Files on the shelf: a tray (and how many, on the right). -->
                    <Path x:Name="CompactShelf" Stroke="#F5F5F7" StrokeThickness="2.2" StrokeLineJoin="Round" Width="17" Height="14" Stretch="Uniform"
                          HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False" Data="M 2,14 L 6,3 L 24,3 L 28,14 L 28,22 Q 28,24 26,24 L 4,24 Q 2,24 2,22 Z M 2,14 L 9,14 L 11,17 L 19,17 L 21,14 L 28,14" />
                    <TextBlock x:Name="CompactShelfCount" FontFamily="{StaticResource SoraFont}" FontSize="13" Foreground="#F5F5F7" HorizontalAlignment="Right"
                               VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False" />
                    <!-- A live activity from a script (TheAI.exe activity …): ring / spinner / check / cross, its name, the percent. -->
                    <StackPanel x:Name="CompactJob" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center"
                                Visibility="Collapsed" IsHitTestVisible="False">
                        <Grid Width="16" Height="16" VerticalAlignment="Center">
                            <Ellipse x:Name="CompactJobTrack" Stroke="#38FFFFFF" StrokeThickness="2.2" />
                            <Path x:Name="CompactJobArc" Stroke="#F5F5F7" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <RotateTransform x:Name="CompactJobSpin" />
                                </Path.RenderTransform>
                            </Path>
                            <Ellipse x:Name="CompactJobDot" Fill="#F5F5F7" Visibility="Collapsed" />
                            <Path x:Name="CompactJobMark" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Visibility="Collapsed" />
                        </Grid>
                        <TextBlock x:Name="CompactJobTitle" FontSize="12.5" Margin="7,0,0,0" Foreground="#F5F5F7" MaxWidth="92"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="CompactJobText" FontFamily="{StaticResource SoraFont}" FontSize="13" Foreground="#F5F5F7" HorizontalAlignment="Right"
                               VerticalAlignment="Center" Typography.NumeralAlignment="Tabular" Visibility="Collapsed" IsHitTestVisible="False" />
                    <!-- During focus or a meeting: what the agents said, held back (a count, opened at the break). -->
                    <Border x:Name="CompactHeld" MinWidth="16" Height="16" CornerRadius="8" Background="#F5F5F7" Padding="4,0"
                            HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,21,0" Visibility="Collapsed" IsHitTestVisible="False">
                        <TextBlock x:Name="CompactHeldText" FontSize="10" FontWeight="Bold" Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <!-- Opens the chat straight from the compact notch, without expanding it first. -->
                    <Button x:Name="CompactChatButton" Style="{StaticResource NotchIconButton}" Width="22" Height="22" Opacity="0"
                            HorizontalAlignment="Left" VerticalAlignment="Center" Click="CompactChatButton_Click"
                            ToolTip="Buka chat" AutomationProperties.Name="Buka chat">
                        <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4"
                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M 3,0.7 L 10,0.7 Q 12.3,0.7 12.3,3 L 12.3,7 Q 12.3,9.3 10,9.3 L 6,9.3 L 3,11.8 L 3,9.3 Q 0.7,9.3 0.7,7 L 0.7,3 Q 0.7,0.7 3,0.7 Z" />
                    </Button>
                    <!-- How many agents run at once (shown from two). -->
                    <TextBlock x:Name="CompactCount" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,21,0"
                               FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource NotchText2}" Visibility="Collapsed" />
                    <!-- At rest: the time, and one glance on the right (temperature or the next prayer). -->
                    <TextBlock x:Name="CompactClock" FontFamily="{StaticResource SoraFont}" FontSize="13" Foreground="#F5F5F7"
                               HorizontalAlignment="Left" VerticalAlignment="Center" Margin="24,0,0,0" Visibility="Collapsed"
                               Typography.NumeralAlignment="Tabular" IsHitTestVisible="False" />
                    <TextBlock x:Name="CompactGlance" FontSize="12.5" Foreground="#A1A1A6" HorizontalAlignment="Right" VerticalAlignment="Center"
                               Margin="0,0,2,0" Visibility="Collapsed" IsHitTestVisible="False" />
                    <Ellipse x:Name="PrivacyDot" Width="6" Height="6" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,-8,0"
                             Visibility="Collapsed" AutomationProperties.Name="Mikrofon atau kamera dipakai" />
                    <Grid x:Name="CompactIndicator" HorizontalAlignment="Right" VerticalAlignment="Center" Width="14" Height="14">
                        <Grid x:Name="SpinnerIndicator" Visibility="Collapsed">
                            <Ellipse Stroke="#2EFFFFFF" StrokeThickness="2.4" />
                            <Path Stroke="#A78BFA" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M 7,1.2 A 5.8,5.8 0 0 1 12.8,7" RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <RotateTransform x:Name="SpinnerRotation" />
                                </Path.RenderTransform>
                            </Path>
                        </Grid>
                        <Grid x:Name="DoneIndicator" Visibility="Collapsed">
                            <Ellipse Fill="{StaticResource NotchGreen}" />
                            <Path Stroke="Black" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Data="M 4,7.3 L 6.1,9.4 L 10.2,4.9" />
                        </Grid>
                        <Ellipse x:Name="WaitIndicator" Width="8" Height="8" Fill="{StaticResource NotchOrange}" Visibility="Collapsed" />
                        <Grid x:Name="QuotaRing" Visibility="Collapsed">
                            <Ellipse Stroke="#33FFFFFF" StrokeThickness="2.2" />
                            <Path x:Name="QuotaArc" Stroke="#E6FFFFFF" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Grid>
                        <!-- Music playing while no agent works: a small equalizer. -->
                        <StackPanel x:Name="CompactEq" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Height="12" Visibility="Collapsed" IsHitTestVisible="False">
                            <Rectangle Width="2.4" Height="12" RadiusX="1.2" RadiusY="1.2" Fill="#FF7AC6" Margin="0.6,0" RenderTransformOrigin="0.5,0.5"><Rectangle.RenderTransform><ScaleTransform ScaleY="0.5" /></Rectangle.RenderTransform></Rectangle>
                            <Rectangle Width="2.4" Height="12" RadiusX="1.2" RadiusY="1.2" Fill="#FF7AC6" Margin="0.6,0" RenderTransformOrigin="0.5,0.5"><Rectangle.RenderTransform><ScaleTransform ScaleY="0.8" /></Rectangle.RenderTransform></Rectangle>
                            <Rectangle Width="2.4" Height="12" RadiusX="1.2" RadiusY="1.2" Fill="#FF7AC6" Margin="0.6,0" RenderTransformOrigin="0.5,0.5"><Rectangle.RenderTransform><ScaleTransform ScaleY="0.4" /></Rectangle.RenderTransform></Rectangle>
                        </StackPanel>
                        <!-- The idle companion: two eyes that blink, and close while the computer is left alone. -->
                        <StackPanel x:Name="CompanionEyes" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="Collapsed" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                            <StackPanel.RenderTransform>
                                <ScaleTransform x:Name="CompanionLids" />
                            </StackPanel.RenderTransform>
                            <Ellipse Width="4" Height="6" Fill="#F5F5F7" Margin="1,0" />
                            <Ellipse Width="4" Height="6" Fill="#F5F5F7" Margin="1,0" />
                        </StackPanel>
                        <Ellipse x:Name="ErrorIndicator" Width="8" Height="8" Fill="{StaticResource NotchRed}" Visibility="Collapsed" />
                    </Grid>
                </Grid>

                <!-- Music: the track playing in any app (Spotify, a browser, Media Player…), its controls and volume. -->
                <!-- Music (Page 2, board 04, V3): cover 104 at P 16, title, artist, a seek bar in the cover's colour and
                     the three controls 40; the record (NotchWindow.LiveObject.cs) leaves the island's left side under the cover. -->
                <Grid x:Name="MusicPanel" Margin="16" Width="388" HorizontalAlignment="Center" VerticalAlignment="Top"
                            Visibility="Collapsed" SizeChanged="Panel_SizeChanged" AutomationProperties.Name="Musik">
                    <Grid.RenderTransform>
                        <TranslateTransform />
                    </Grid.RenderTransform>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel x:Name="MusicMain">
                        <Grid Height="18">
                            <TextBlock Style="{StaticResource IslandMeta}" HorizontalAlignment="Left" Text="{local:Tr Sedang diputar, En=Now playing}" />
                            <TextBlock x:Name="MusicSource" Style="{StaticResource IslandMeta}" HorizontalAlignment="Right" />
                        </Grid>
                        <Grid Height="64" Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="MusicTitle" Style="{StaticResource IslandTitle}" />
                                <TextBlock x:Name="MusicArtist" Style="{StaticResource IslandMeta}" FontWeight="Normal" Margin="1,2,0,0" />
                            </StackPanel>
                            <Border x:Name="MusicArt" Grid.Column="1" Width="64" Height="64" CornerRadius="16" Margin="12,0,0,0" Background="#1C1C1E">
                                <Path x:Name="MusicArtPlaceholder" Fill="#7C7C80" Width="20" Height="20" Stretch="Uniform"
                                      Data="M 6,2 L 16,0 L 16,12 A 3,3 0 1 1 14,9.2 L 14,3.4 L 8,4.6 L 8,14 A 3,3 0 1 1 6,11.2 Z" />
                            </Border>
                            <Button x:Name="MusicPlayButton" Grid.Column="2" Style="{StaticResource IslandRoundButton}" Background="#F5F5F7" Foreground="Black" Height="40" Margin="12,0,0,0"
                                    VerticalAlignment="Center" Click="MusicPlay_Click" AutomationProperties.Name="Putar/jeda">
                                <Grid>
                                    <Path x:Name="MusicPlayGlyph" Fill="Black" Data="M 0,0 L 13,7.5 L 0,15 Z" Margin="2,0,0,0" />
                                    <Path x:Name="MusicPauseGlyph" Fill="Black" Data="M 0,0 L 4,0 L 4,15 L 0,15 Z M 8,0 L 12,0 L 12,15 L 8,15 Z" Visibility="Collapsed" />
                                </Grid>
                            </Button>
                        </Grid>
                        <StackPanel x:Name="MusicEq" Visibility="Collapsed" Orientation="Horizontal" IsHitTestVisible="False">
                            <Rectangle Width="3" Height="18"><Rectangle.RenderTransform><ScaleTransform /></Rectangle.RenderTransform></Rectangle>
                            <Rectangle Width="3" Height="18"><Rectangle.RenderTransform><ScaleTransform /></Rectangle.RenderTransform></Rectangle>
                            <Rectangle Width="3" Height="18"><Rectangle.RenderTransform><ScaleTransform /></Rectangle.RenderTransform></Rectangle>
                            <Rectangle Width="3" Height="18"><Rectangle.RenderTransform><ScaleTransform /></Rectangle.RenderTransform></Rectangle>
                        </StackPanel>

                        <!-- Hidden in the track-change toast; hovering the toast opens it all. -->
                        <StackPanel x:Name="MusicFull">
                            <!-- The song's shape is the seek bar: click or drag to move. -->
                            <Grid x:Name="MusicProgress" Height="64" Margin="0,10,0,0" Background="Transparent" Cursor="Hand"
                                  MouseLeftButtonDown="MusicBar_MouseDown" MouseMove="MusicBar_MouseMove" MouseLeftButtonUp="MusicBar_MouseUp"
                                  AutomationProperties.Name="Posisi lagu">
                                <local:Waveform x:Name="MusicWave" />
                                <Border x:Name="MusicProgressTrack" Visibility="Collapsed" />
                                <Border x:Name="MusicProgressFill" Visibility="Collapsed" HorizontalAlignment="Left" Width="0" />
                            </Grid>
                            <Grid Height="40" Margin="0,16,0,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,2">
                                    <StackPanel Width="76">
                                        <TextBlock Style="{StaticResource IslandFootLabel}" Foreground="#7C7C80" Text="{local:Tr Berjalan, En=Gone}" />
                                        <TextBlock x:Name="MusicElapsed" Style="{StaticResource IslandFootValue}" Foreground="#98989F" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource IslandFootLabel}" Foreground="#7C7C80" Text="{local:Tr Sisa, En=Left}" />
                                        <TextBlock x:Name="MusicRemaining" Style="{StaticResource IslandFootValue}" Foreground="#98989F" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button x:Name="MusicPrevButton" Style="{StaticResource IslandRoundButton}" Height="40" Background="#1C1C1E" Foreground="#F5F5F7" Margin="0,0,8,0"
                                            Click="MusicPrev_Click" AutomationProperties.Name="Lagu sebelumnya">
                                        <Path Fill="#F5F5F7" Data="M 0,0 L 2.4,0 L 2.4,14 L 0,14 Z M 14,0 L 14,14 L 3.4,7 Z" />
                                    </Button>
                                    <Button x:Name="MusicNextButton" Style="{StaticResource IslandRoundButton}" Height="40" Background="#1C1C1E" Foreground="#F5F5F7"
                                            Click="MusicNext_Click" AutomationProperties.Name="Lagu berikutnya">
                                        <Path Fill="#F5F5F7" Data="M 0,0 L 10.6,7 L 0,14 Z M 11.6,0 L 14,0 L 14,14 L 11.6,14 Z" />
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- The app's own volume: kept, but off the page. -->
                            <Grid x:Name="MusicVolumeRow" Visibility="Collapsed">
                                <Grid x:Name="MusicVolume" Height="14" Background="Transparent"
                                      MouseLeftButtonDown="MusicBar_MouseDown" MouseMove="MusicBar_MouseMove" MouseLeftButtonUp="MusicBar_MouseUp">
                                    <Border x:Name="MusicVolumeFill" Width="0" />
                                </Grid>
                                <TextBlock x:Name="MusicVolumeLabel" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                    <!-- Synced lyrics beside the player: the line being sung in white; click any line to jump there. -->
                    <Border x:Name="MusicLyricsSide" Grid.Column="1" Width="236" Margin="18,0,0,0" Padding="16,0,0,0"
                            BorderBrush="#1AFFFFFF" BorderThickness="1,0,0,0" Visibility="Collapsed" ClipToBounds="True"
                            AutomationProperties.Name="Lirik">
                        <StackPanel x:Name="MusicLyricLines" VerticalAlignment="Center" />
                    </Border>
                </Grid>

                <!-- Timer, after the Clock app's live activities and DynamicLake's stacked rows: one row per
                     thing running (tinted control, grey control, label, time in Sora), a minute ruler with
                     mode icons when nothing runs, and typing that lands in the row itself. -->
                <StackPanel x:Name="TimerPanel" Margin="16" Width="388" HorizontalAlignment="Center" VerticalAlignment="Top"
                            Visibility="Collapsed" SizeChanged="Panel_SizeChanged" AutomationProperties.Name="Timer"
                            PreviewMouseLeftButtonDown="TimerPanel_PreviewMouseDown">
                    <StackPanel.RenderTransform>
                        <TranslateTransform />
                    </StackPanel.RenderTransform>

                    <!-- One thing on the page (boards 31-33): label and meta, the number, a ruler, the facts. -->
                    <StackPanel x:Name="ShutdownRun" Visibility="Collapsed">
                        <Grid Height="18">
                            <TextBlock Style="{StaticResource IslandMeta}" HorizontalAlignment="Left" Text="{local:Tr Matikan PC, En=Shut down}" />
                            <TextBlock x:Name="ShutdownMeta" Style="{StaticResource IslandMeta}" HorizontalAlignment="Right" />
                        </Grid>
                        <Grid Height="64" Margin="0,4,0,0">
                            <TextBlock x:Name="ShutdownBig" Style="{StaticResource IslandHero}" />
                            <Button Style="{StaticResource IslandRoundButton}" Background="#F5F5F7" Height="40" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Click="ShutdownCancel_Click" AutomationProperties.Name="Batalkan" ToolTip="{local:Tr Batalkan, En=Call it off}">
                                <Path Stroke="Black" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 1,1 L 11,11 M 11,1 L 1,11" />
                            </Button>
                        </Grid>
                        <local:RulerPicker x:Name="ShutdownRuler" Height="64" Margin="-16,10,-16,0" MaxMinutes="1440" IsHitTestVisible="False" />
                        <local:SpaceBetweenPanel Height="38" Margin="0,18,0,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource IslandFootLabel}" Foreground="#7C7C80" Text="{local:Tr Mulai, En=Started}" />
                                <TextBlock x:Name="ShutdownFootStart" Style="{StaticResource IslandFootValue}" Foreground="#98989F" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Style="{StaticResource IslandFootLabel}" Foreground="#7C7C80" Text="{local:Tr Berjalan, En=Gone}" />
                                <TextBlock x:Name="ShutdownFootGone" Style="{StaticResource IslandFootValue}" Foreground="#98989F" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Style="{StaticResource IslandFootLabel}" Foreground="#7C7C80" Text="{local:Tr Durasi, En=Length}" />
                                <TextBlock x:Name="ShutdownFootLength" Style="{StaticResource IslandFootValue}" Foreground="#98989F" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Style="{StaticResource IslandFootLabel}" Foreground="#7C7C80" HorizontalAlignment="Right" Text="{local:Tr Aplikasi, En=Apps}" />
                                <TextBlock Style="{StaticResource IslandFootValue}" Foreground="#FF453A" Text="{local:Tr Ditutup paksa, En=Force closed}" />
                            </StackPanel>
                        </local:SpaceBetweenPanel>
                    </StackPanel>

                    <StackPanel x:Name="TimerRunRow">
                        <Grid Height="18">
                            <Path x:Name="TimerCaptionIcon" Visibility="Collapsed" />
                            <TextBlock x:Name="TimerCaption" Style="{StaticResource IslandMeta}" HorizontalAlignment="Left" MaxWidth="200" />
                            <TextBlock x:Name="TimerRunMeta" Style="{StaticResource IslandMeta}" HorizontalAlignment="Right" />
                        </Grid>
                        <Grid Height="64" Margin="0,4,0,0">
                            <TextBlock x:Name="TimerBig" Style="{StaticResource IslandHero}" Text="24:12" />
                            <Button x:Name="TimerPlayButton" Style="{StaticResource IslandRoundButton}" Background="#F5F5F7" Height="40" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Click="TimerPlay_Click" AutomationProperties.Name="Jeda">
                                <Grid>
                                    <Path x:Name="TimerPlayGlyph" Fill="Black" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0,0,0" Width="14" Height="15" Stretch="Uniform" Data="M 2,1.5 Q 2,0 3.4,0.8 L 16.4,8.8 Q 17.6,9.6 16.4,10.4 L 3.4,18.4 Q 2,19.2 2,17.7 Z" />
                                    <Path x:Name="TimerPauseGlyph" Fill="Black" HorizontalAlignment="Center" VerticalAlignment="Center" Width="11" Height="14" Stretch="Uniform" Data="M 1,1.5 Q 1,0 2.5,0 L 4,0 Q 5.4,0 5.4,1.5 L 5.4,16.5 Q 5.4,18 4,18 L 2.5,18 Q 1,18 1,16.5 Z M 9,1.5 Q 9,0 10.5,0 L 12,0 Q 13.4,0 13.4,1.5 L 13.4,16.5 Q 13.4,18 12,18 L 10.5,18 Q 9,18 9,16.5 Z" />
                                </Grid>
                            </Button>
                        </Grid>
                        <local:RulerPicker x:Name="TimerRunRuler" Height="64" Margin="-16,10,-16,0" IsHitTestVisible="False" />
                        <local:SpaceBetweenPanel Height="38" Margin="0,18,0,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource IslandFootLabel}" Foreground="#7C7C80" Text="{local:Tr Mulai, En=Started}" />
                                <TextBlock x:Name="TimerFootStart" Style="{StaticResource IslandFootValue}" Foreground="#98989F" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Style="{StaticResource IslandFootLabel}" Foreground="#7C7C80" Text="{local:Tr Berjalan, En=Gone}" />
                                <TextBlock x:Name="TimerFootGone" Style="{StaticResource IslandFootValue}" Foreground="#98989F" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Style="{StaticResource IslandFootLabel}" Foreground="#7C7C80" Text="{local:Tr Durasi, En=Length}" />
                                <TextBlock x:Name="TimerFootLength" Style="{StaticResource IslandFootValue}" Foreground="#98989F" />
                            </StackPanel>
                            <Button x:Name="TimerStopButton" Style="{StaticResource IslandFootButton}" Click="TimerReset_Click" AutomationProperties.Name="Hentikan">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource IslandFootLabel}" HorizontalAlignment="Right" Text="{local:Tr Batal, En=Cancel}" />
                                    <TextBlock x:Name="TimerStopValue" Style="{StaticResource IslandFootValue}" HorizontalAlignment="Right" />
                                </StackPanel>
                            </Button>
                        </local:SpaceBetweenPanel>
                    </StackPanel>

                    <Grid x:Name="TimerWatchRow" Height="56" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="TimerWatchPlay" Style="{StaticResource NotchTintButton}" Width="40" Height="40"
                                Background="#38FFFFFF" Click="TimerWatchPlay_Click" AutomationProperties.Name="Jeda">
                            <Grid>
                                <Path x:Name="TimerWatchPlayGlyph" Fill="#F5F5F7" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="3,0,0,0"
                                      Data="M 2,1.5 Q 2,0 3.4,0.8 L 16.4,8.8 Q 17.6,9.6 16.4,10.4 L 3.4,18.4 Q 2,19.2 2,17.7 Z" />
                                <Path x:Name="TimerWatchPauseGlyph" Fill="#F5F5F7" HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Data="M 1,1.5 Q 1,0 2.5,0 L 4,0 Q 5.4,0 5.4,1.5 L 5.4,16.5 Q 5.4,18 4,18 L 2.5,18 Q 1,18 1,16.5 Z M 9,1.5 Q 9,0 10.5,0 L 12,0 Q 13.4,0 13.4,1.5 L 13.4,16.5 Q 13.4,18 12,18 L 10.5,18 Q 9,18 9,16.5 Z" />
                            </Grid>
                        </Button>
                        <Button x:Name="TimerWatchReset" Grid.Column="1" Style="{StaticResource NotchTintButton}" Width="40" Height="40" Margin="10,0,0,0"
                                Background="#1FFFFFFF" Click="TimerWatchReset_Click" AutomationProperties.Name="Reset">
                            <Path Stroke="White" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Data="M 15,9 A 6,6 0 1 1 13.2,4.7 M 13.6,1.6 L 13.6,5.2 L 10,5.2" />
                        </Button>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Path x:Name="TimerWatchLapIcon" Fill="#99FFFFFF" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" Margin="0,2,6,0"
                                  Data="F0 M3,1.5 H4.6 V14.5 H3 Z M4.6,2 H13 L10.8,5 L13,8 H4.6 Z" />
                            <TextBlock x:Name="TimerWatchLap" Style="{StaticResource NotchLabel}" Foreground="#99FFFFFF" Margin="0,4,12,0" />
                            <TextBlock x:Name="TimerWatchBig" Style="{StaticResource NotchDigits}" Text="00:00.00" />
                        </StackPanel>
                    </Grid>

                    <!-- An alarm is set: its own row, stacked like DynamicLake's. -->
                    <Grid x:Name="TimerAlarmRow" Height="56">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ContentControl Content="{StaticResource NotchAlarmGlyph}" Width="38" Height="38" VerticalAlignment="Center" Margin="7,0,0,0" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                            <TextBlock x:Name="TimerAlarmCaption" Style="{StaticResource NotchLabel}" FontSize="20" MaxWidth="150" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="TimerAlarmTime" Style="{StaticResource NotchLabel}" FontSize="20" Margin="16,0,0,0" />
                        </StackPanel>
                        <Button x:Name="TimerAlarmCancel" Grid.Column="2" Style="{StaticResource NotchTintButton}" Width="40" Height="40"
                                Background="#1FFFFFFF" Click="TimerAlarmCancel_Click" AutomationProperties.Name="Hapus alarm">
                            <Path Stroke="White" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 1,1 L 12,12 M 12,1 L 1,12" />
                        </Button>
                    </Grid>

                    <!-- Nothing running (board 32 A): the length on a ruler, start where the pause will be, the modes below. -->
                    <StackPanel x:Name="TimerIdle">
                        <Grid Height="18">
                            <TextBlock x:Name="TimerIdleCaption" Style="{StaticResource IslandMeta}" HorizontalAlignment="Left" MaxWidth="240" />
                            <TextBlock x:Name="TimerIdleMeta" Style="{StaticResource IslandMeta}" HorizontalAlignment="Right" />
                        </Grid>
                        <Grid Height="64" Margin="0,4,0,0">
                            <TextBlock x:Name="TimerIdleDigits" Style="{StaticResource IslandHero}" Text="25:00" />
                            <Button x:Name="ShutdownKind" Style="{StaticResource IslandChip}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,52,0"
                                    Visibility="Collapsed" Click="ShutdownKind_Click" />
                            <Button x:Name="TimerStartButton" Style="{StaticResource IslandRoundButton}" Background="#F5F5F7" Height="40" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Click="TimerStart_Click" AutomationProperties.Name="Mulai">
                                <Path Fill="Black" Margin="2,0,0,0" Width="14" Height="15" Stretch="Uniform" Data="M 2,1.5 Q 2,0 3.4,0.8 L 16.4,8.8 Q 17.6,9.6 16.4,10.4 L 3.4,18.4 Q 2,19.2 2,17.7 Z" />
                            </Button>
                        </Grid>
                        <local:RulerPicker x:Name="TimerWheel" Height="64" Margin="-16,10,-16,0" />
                        <local:SpaceBetweenPanel x:Name="TimerModes" Height="38" Margin="0,18,0,0">
                            <Button x:Name="TimerModeTimer" Style="{StaticResource IslandFootButton}" Click="TimerMode_Click" ToolTip="Timer" AutomationProperties.Name="Timer">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource IslandFootLabel}" Text="Timer" />
                                    <TextBlock x:Name="TimerModeTimerValue" Style="{StaticResource IslandFootValue}" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="TimerModePomodoro" Style="{StaticResource IslandFootButton}" Click="TimerMode_Click" ToolTip="Pomodoro" AutomationProperties.Name="Pomodoro">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource IslandFootLabel}" Text="Pomodoro" />
                                    <TextBlock x:Name="TimerModePomodoroValue" Style="{StaticResource IslandFootValue}" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="TimerModeStopwatch" Style="{StaticResource IslandFootButton}" Click="TimerMode_Click" ToolTip="Stopwatch" AutomationProperties.Name="Stopwatch">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource IslandFootLabel}" Text="Stopwatch" />
                                    <TextBlock x:Name="TimerModeStopwatchValue" Style="{StaticResource IslandFootValue}" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="TimerModeAlarm" Style="{StaticResource IslandFootButton}" Click="TimerMode_Click" ToolTip="Alarm (@7:30)" AutomationProperties.Name="Alarm (@7:30)">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource IslandFootLabel}" Text="Alarm" />
                                    <TextBlock x:Name="TimerModeAlarmValue" Style="{StaticResource IslandFootValue}" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="TimerModeShutdown" Style="{StaticResource IslandFootButton}" Click="TimerMode_Click" ToolTip="shutdown -s -t X" AutomationProperties.Name="shutdown -s -t X">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource IslandFootLabel}" HorizontalAlignment="Right" Text="{local:Tr Matikan, En=Shut down}" />
                                    <TextBlock x:Name="TimerModeShutdownValue" Style="{StaticResource IslandFootValue}" HorizontalAlignment="Right" />
                                </StackPanel>
                            </Button>
                        </local:SpaceBetweenPanel>
                    </StackPanel>

                    <!-- Keystrokes land here; the row shows them in place of its label, the number shows the result. -->
                    <TextBox x:Name="TimerInput" Width="1" Height="1" Opacity="0" IsTabStop="False" HorizontalAlignment="Left"
                             TextChanged="TimerInput_TextChanged" PreviewKeyDown="TimerInput_PreviewKeyDown"
                             AutomationProperties.Name="Perintah timer" />
                </StackPanel>

                <!-- Time's up / the alarm rings: the same row, now green or ringing. -->
                <Grid x:Name="TimerDonePanel" Margin="16" Width="388" HorizontalAlignment="Center" VerticalAlignment="Top"
                      Visibility="Collapsed" SizeChanged="Panel_SizeChanged" AutomationProperties.Name="Waktu habis">
                    <Grid.RenderTransform>
                        <TranslateTransform />
                    </Grid.RenderTransform>
                    <StackPanel x:Name="TimerDoneRow">
                        <Grid Height="18">
                            <Path x:Name="TimerDoneIcon" Visibility="Collapsed" />
                            <TextBlock x:Name="TimerDoneTitle" Style="{StaticResource IslandMeta}" HorizontalAlignment="Left" MaxWidth="220" />
                            <TextBlock x:Name="TimerDoneSub" Style="{StaticResource IslandMeta}" HorizontalAlignment="Right" MaxWidth="200" />
                        </Grid>
                        <Grid Height="64" Margin="0,4,0,0">
                            <TextBlock x:Name="TimerDoneDigits" Style="{StaticResource IslandHero}" Text="00:00" />
                            <Path x:Name="TimerDoneNextGlyph" Visibility="Collapsed" />
                            <Button Style="{StaticResource IslandRoundButton}" Background="#F5F5F7" Height="40" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Click="TimerDoneNext_Click" AutomationProperties.Name="Mulai lagi">
                                <Path Fill="Black" Margin="2,0,0,0" Width="14" Height="15" Stretch="Uniform" Data="M 2,1.5 Q 2,0 3.4,0.8 L 16.4,8.8 Q 17.6,9.6 16.4,10.4 L 3.4,18.4 Q 2,19.2 2,17.7 Z" />
                            </Button>
                        </Grid>
                        <local:RulerPicker x:Name="TimerDoneRuler" Height="64" Margin="-16,10,-16,0" IsHitTestVisible="False" Value="0:0:0" />
                        <local:SpaceBetweenPanel Height="38" Margin="0,18,0,0">
                            <Button x:Name="TimerDoneNext" Style="{StaticResource IslandFootButton}" Tag="selected" Click="TimerDoneNext_Click" AutomationProperties.Name="Langkah berikutnya">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource IslandFootLabel}" Text="{local:Tr Berikutnya, En=Next}" />
                                    <TextBlock x:Name="TimerDoneNextText" Style="{StaticResource IslandFootValue}" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="TimerDoneClose" Style="{StaticResource IslandFootButton}" Click="TimerDoneClose_Click" AutomationProperties.Name="Tutup">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource IslandFootLabel}" HorizontalAlignment="Right" Text="{local:Tr Selesai, En=Done}" />
                                    <TextBlock x:Name="TimerDoneCloseText" Style="{StaticResource IslandFootValue}" HorizontalAlignment="Right" />
                                </StackPanel>
                            </Button>
                        </local:SpaceBetweenPanel>
                    </StackPanel>
                    <Grid x:Name="TimerRingRow" Height="56" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ContentControl x:Name="TimerRingIcon" Content="{StaticResource NotchAlarmGlyph}" Width="40" Height="40" VerticalAlignment="Center"
                                        Margin="6,0,0,0" RenderTransformOrigin="0.5,0.3">
                            <ContentControl.RenderTransform>
                                <RotateTransform />
                            </ContentControl.RenderTransform>
                        </ContentControl>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                            <TextBlock x:Name="TimerRingCaption" Style="{StaticResource NotchLabel}" FontSize="20" MaxWidth="120" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="TimerRingTime" Style="{StaticResource NotchLabel}" FontSize="20" Margin="16,0,0,0" />
                        </StackPanel>
                        <Button x:Name="TimerSnoozeButton" Grid.Column="2" Style="{StaticResource NotchTintButton}" Width="40" Height="40"
                                Background="#38FFFFFF" Click="TimerSnooze_Click" AutomationProperties.Name="Tunda 9 menit">
                            <Canvas Width="22" Height="22">
                                <TextBlock Text="Z" FontFamily="{StaticResource SoraFont}" FontSize="13" Foreground="#F5F5F7" Canvas.Left="1" Canvas.Top="-1" />
                                <TextBlock Text="Z" FontFamily="{StaticResource SoraFont}" FontSize="13" Foreground="#F5F5F7" Canvas.Left="11" Canvas.Top="3" />
                                <TextBlock Text="z" FontFamily="{StaticResource SoraFont}" FontSize="12" Foreground="#F5F5F7" Canvas.Left="3" Canvas.Top="9" />
                            </Canvas>
                        </Button>
                        <Button x:Name="TimerRingClose" Grid.Column="3" Style="{StaticResource NotchTintButton}" Width="40" Height="40" Margin="10,0,0,0"
                                Background="#1FFFFFFF" Click="TimerDoneClose_Click" AutomationProperties.Name="Matikan alarm">
                            <Path Stroke="White" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 1,1 L 12,12 M 12,1 L 1,12" />
                        </Button>
                    </Grid>
                </Grid>

                <!-- System HUD: volume, brightness, battery, headphones — a slightly wider compact notch for a moment. -->
                <Grid x:Name="HudPanel" Height="40" Width="232" Margin="4,0" HorizontalAlignment="Center" VerticalAlignment="Top"
                      Visibility="Collapsed" SizeChanged="Panel_SizeChanged" IsHitTestVisible="False">
                    <Grid.RenderTransform>
                        <TranslateTransform />
                    </Grid.RenderTransform>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!-- Volume and brightness: the whole capsule is the slider (fill behind icon and number). -->
                    <Border x:Name="HudCapsule" Grid.ColumnSpan="3" Margin="0,4,0,4" CornerRadius="16" Background="#1C1C1E" Visibility="Collapsed">
                        <Border x:Name="HudCapsuleFill" HorizontalAlignment="Left" CornerRadius="16" Width="0" />
                    </Border>
                    <Grid Width="26" VerticalAlignment="Center" Margin="12,0,0,0">
                        <Path x:Name="HudIconFill" Fill="#F5F5F7" HorizontalAlignment="Left" VerticalAlignment="Center" />
                        <Path x:Name="HudIconStroke" Stroke="#F5F5F7" StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              HorizontalAlignment="Left" VerticalAlignment="Center" />
                        <Grid x:Name="HudIconBattery" Width="26" Height="13" HorizontalAlignment="Left" Visibility="Collapsed">
                            <Border Width="22" Height="13" HorizontalAlignment="Left" CornerRadius="3.5" BorderBrush="#F5F5F7" BorderThickness="1.4" />
                            <Border x:Name="HudIconBatteryFill" Height="7" Width="3" Margin="3,0,0,0" HorizontalAlignment="Left" CornerRadius="1.5" Background="#FF453A" />
                            <Border Width="2" Height="5" HorizontalAlignment="Right" Margin="0,0,1,0" CornerRadius="1" Background="#F5F5F7" />
                        </Grid>
                    </Grid>
                    <Grid x:Name="HudBar" Grid.Column="1" Height="5" Margin="10,0,0,0" VerticalAlignment="Center">
                        <Border CornerRadius="2.5" Background="#2EFFFFFF" />
                        <Border x:Name="HudBarFill" CornerRadius="2.5" Background="#F5F5F7" HorizontalAlignment="Left" Width="0" />
                    </Grid>
                    <TextBlock x:Name="HudName" Grid.Column="1" Margin="10,0,10,0" VerticalAlignment="Center" FontSize="12" Foreground="#99FFFFFF"
                               TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
                    <StackPanel x:Name="HudValue" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0" Visibility="Collapsed">
                        <TextBlock x:Name="HudText" FontFamily="{StaticResource SoraFont}" FontSize="13" Foreground="#F5F5F7" VerticalAlignment="Center"
                                   Typography.NumeralAlignment="Tabular" />
                        <Grid x:Name="HudBattery" Width="26" Height="13" Margin="8,0,0,0" VerticalAlignment="Center">
                            <Border Width="22" Height="13" HorizontalAlignment="Left" CornerRadius="3.5" BorderBrush="#F5F5F7" BorderThickness="1.4" />
                            <Border x:Name="HudBatteryFill" Height="7" Width="14" Margin="3,0,0,0" HorizontalAlignment="Left" CornerRadius="1.5" Background="#F5F5F7" />
                            <Border Width="2" Height="5" HorizontalAlignment="Right" Margin="0,0,1,0" CornerRadius="1" Background="#F5F5F7" />
                        </Grid>
                    </StackPanel>
                </Grid>

                <!-- The file shelf: files waiting to be dragged out somewhere. -->
                <Grid x:Name="ShelfPanel" Margin="16" Width="388" HorizontalAlignment="Center" VerticalAlignment="Top"
                      Visibility="Collapsed" SizeChanged="Panel_SizeChanged" AutomationProperties.Name="Rak file">
                    <Grid.RenderTransform>
                        <TranslateTransform />
                    </Grid.RenderTransform>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <WrapPanel x:Name="ShelfItems" />
                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <Button Style="{StaticResource NotchTintButton}" Width="40" Height="40" Background="#38FFFFFF" Click="ShelfSaveAll_Click"
                                ToolTip="Simpan semua ke folder" AutomationProperties.Name="Simpan semua ke folder">
                            <Path Stroke="#F5F5F7" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Data="M 7,1 L 7,10 M 3.5,6.5 L 7,10 L 10.5,6.5 M 1,12 L 1,13.5 L 13,13.5 L 13,12" />
                        </Button>
                        <Button Style="{StaticResource NotchTintButton}" Width="40" Height="40" Margin="0,8,0,0" Background="#1FFFFFFF" Click="ShelfClear_Click"
                                ToolTip="Kosongkan rak" AutomationProperties.Name="Kosongkan rak">
                            <Path Stroke="#F5F5F7" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 1,1 L 11,11 M 11,1 L 1,11" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Today's calendar: the next event large (with a camera to join its call), then the rest. -->
                <StackPanel x:Name="CalendarPanel" Margin="16" Width="388" HorizontalAlignment="Center" VerticalAlignment="Top"
                            Visibility="Collapsed" SizeChanged="Panel_SizeChanged" AutomationProperties.Name="Kalender">
                    <StackPanel.RenderTransform>
                        <TranslateTransform />
                    </StackPanel.RenderTransform>
                    <StackPanel x:Name="CalendarRows" />
                </StackPanel>

                <!-- Live activities: every job a script reports, with its progress or what went wrong. -->
                <StackPanel x:Name="JobsPanel" Margin="16" Width="388" HorizontalAlignment="Center" VerticalAlignment="Top"
                            Visibility="Collapsed" SizeChanged="Panel_SizeChanged" AutomationProperties.Name="Aktivitas">
                    <StackPanel.RenderTransform>
                        <TranslateTransform />
                    </StackPanel.RenderTransform>
                    <StackPanel x:Name="JobRows" />
                </StackPanel>

                <!-- The break after focus (or the end of a meeting): what the agents did meanwhile, all at once. -->
                <StackPanel x:Name="HeldPanel" Margin="16" Width="388" HorizontalAlignment="Center" VerticalAlignment="Top" Visibility="Collapsed" SizeChanged="Panel_SizeChanged" AutomationProperties.Name="Selama fokus">
                    <StackPanel.RenderTransform>
                        <TranslateTransform />
                    </StackPanel.RenderTransform>
                    <Grid Height="18">
                        <TextBlock x:Name="HeldTitle" Style="{StaticResource IslandMeta}" HorizontalAlignment="Left" />
                        <TextBlock x:Name="HeldMeta" Style="{StaticResource IslandMeta}" HorizontalAlignment="Right" />
                    </Grid>
                    <Grid Height="64" Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="HeldHeroTitle" Style="{StaticResource IslandTitle}" />
                            <TextBlock x:Name="HeldHeroSub" Style="{StaticResource IslandMeta}" FontWeight="Normal" Margin="1,2,0,0" />
                        </StackPanel>
                        <Button x:Name="HeldOpen" Grid.Column="1" Style="{StaticResource IslandRoundButton}" Background="#F5F5F7" Height="40" Margin="12,0,0,0" VerticalAlignment="Center" Click="HeldOpen_Click" AutomationProperties.Name="Lihat">
                            <Path Stroke="Black" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M 0,6 L 13,6 M 8,1 L 13,6 L 8,11" />
                        </Button>
                    </Grid>
                    <ScrollViewer Height="120" Margin="0,10,0,0" VerticalScrollBarVisibility="Hidden">
                        <StackPanel x:Name="HeldRows" />
                    </ScrollViewer>
                </StackPanel>

                <!-- Today, recapped: tiles with the day's numbers, the latest things done, a copy for standup. -->
                <StackPanel x:Name="RecapPanel" Margin="16" Width="388" HorizontalAlignment="Center" VerticalAlignment="Top" Visibility="Collapsed" SizeChanged="Panel_SizeChanged" AutomationProperties.Name="Rekap hari ini">
                    <StackPanel.RenderTransform>
                        <TranslateTransform />
                    </StackPanel.RenderTransform>
                    <Grid Height="18">
                        <TextBlock x:Name="RecapTitle" Style="{StaticResource IslandMeta}" HorizontalAlignment="Left" Text="{local:Tr Hari ini, En=Today}" />
                        <TextBlock x:Name="RecapDate" Style="{StaticResource IslandMeta}" HorizontalAlignment="Right" MaxWidth="290" />
                    </Grid>
                    <Grid Height="64" Margin="0,4,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="RecapValue" Style="{StaticResource IslandHero}" />
                            <TextBlock x:Name="RecapUnit" Style="{StaticResource IslandHeroUnit}" />
                        </StackPanel>
                        <Button x:Name="RecapCopy" Style="{StaticResource IslandRoundButton}" Background="#F5F5F7" Height="40" HorizontalAlignment="Right" VerticalAlignment="Center" Click="RecapCopy_Click"
                                AutomationProperties.Name="Salin untuk standup" ToolTip="{local:Tr Salin untuk standup, En=Copy for standup}">
                            <Path Stroke="Black" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="16" Height="16" Stretch="Uniform"
                                  Data="M 8,8 L 20,8 Q 22,8 22,10 L 22,20 Q 22,22 20,22 L 10,22 Q 8,22 8,20 Z M 4,16 C 2.9,16 2,15.1 2,14 L 2,4 C 2,2.9 2.9,2 4,2 L 14,2 C 15.1,2 16,2.9 16,4" />
                        </Button>
                    </Grid>
                    <ScrollViewer Height="120" Margin="0,10,0,0" VerticalScrollBarVisibility="Hidden">
                        <StackPanel x:Name="RecapRows" />
                    </ScrollViewer>
                </StackPanel>

                <!-- Clipboard history: tiles of what was copied lately (click = copy, drag = paste, right-click = pin). -->
                <!-- Clipboard (Page 2 language): a 17 title, the hint under it, cards R 20 on surface/1 three across, P 16. -->
                <StackPanel x:Name="ClipPanel" Margin="16" Width="388" HorizontalAlignment="Center" VerticalAlignment="Top" Background="Transparent"
                            Visibility="Collapsed" SizeChanged="Panel_SizeChanged" AutomationProperties.Name="Clipboard">
                    <StackPanel.RenderTransform>
                        <TranslateTransform />
                    </StackPanel.RenderTransform>
                    <!-- Board 32 A: the newest as the title, what came before as rows 40. -->
                    <Grid Height="18">
                        <TextBlock Style="{StaticResource IslandMeta}" HorizontalAlignment="Left" Text="{local:Tr Terbaru, En=Latest}" />
                        <TextBlock x:Name="ClipHint" Style="{StaticResource IslandMeta}" HorizontalAlignment="Right" MaxWidth="240" />
                    </Grid>
                    <Grid Height="64" Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="ClipTitle" Style="{StaticResource IslandTitle}" />
                            <TextBlock x:Name="ClipSub" Style="{StaticResource IslandMeta}" FontWeight="Normal" Margin="1,2,0,0" />
                        </StackPanel>
                        <Border x:Name="ClipThumb" Grid.Column="1" Width="64" Height="64" CornerRadius="16" Margin="12,0,0,0" Visibility="Collapsed" />
                        <Button x:Name="ClipCopyButton" Grid.Column="2" Style="{StaticResource IslandRoundButton}" Background="#F5F5F7" Height="40" Margin="12,0,0,0" VerticalAlignment="Center"
                                Click="ClipCopy_Click" AutomationProperties.Name="Salin" ToolTip="{local:Tr Salin, En=Copy}">
                            <Path Stroke="Black" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="16" Height="16" Stretch="Uniform"
                                  Data="M 8,8 L 20,8 Q 22,8 22,10 L 22,20 Q 22,22 20,22 L 10,22 Q 8,22 8,20 Z M 4,16 C 2.9,16 2,15.1 2,14 L 2,4 C 2,2.9 2.9,2 4,2 L 14,2 C 15.1,2 16,2.9 16,4" />
                        </Button>
                    </Grid>
                    <ScrollViewer x:Name="ClipScroll" Height="120" Margin="0,10,0,0" VerticalScrollBarVisibility="Hidden">
                        <StackPanel x:Name="ClipTiles" />
                    </ScrollViewer>
                    <TextBlock x:Name="ClipEmpty" Visibility="Collapsed" Height="0" />
                </StackPanel>

                <!-- The machine (board 31): one reading large, its last minute as a line, the four below. -->
                <StackPanel x:Name="SystemPanel" Margin="16" Width="388" HorizontalAlignment="Center" VerticalAlignment="Top"
                            Visibility="Collapsed" SizeChanged="Panel_SizeChanged" AutomationProperties.Name="Sistem">
                    <StackPanel.RenderTransform>
                        <TranslateTransform />
                    </StackPanel.RenderTransform>
                    <Grid Height="18">
                        <TextBlock x:Name="SystemLabel" Style="{StaticResource IslandMeta}" HorizontalAlignment="Left" />
                        <TextBlock x:Name="SystemMeta" Style="{StaticResource IslandMeta}" HorizontalAlignment="Right" MaxWidth="260" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Height="64" Margin="0,4,0,0">
                        <TextBlock x:Name="SystemValue" Style="{StaticResource IslandHero}" />
                        <TextBlock x:Name="SystemUnit" Style="{StaticResource IslandHeroUnit}" />
                    </StackPanel>
                    <local:Sparkline x:Name="SystemLine" Height="72" Margin="-16,8,0,0" />
                    <local:SpaceBetweenPanel x:Name="SystemRows" Height="38" Margin="0,12,0,0" />
                </StackPanel>

                <!-- Reminders & to-dos: the open ones (due first), and a field to add one. -->
                <StackPanel x:Name="ReminderPanel" Margin="16" Width="388" HorizontalAlignment="Center" VerticalAlignment="Top" Visibility="Collapsed" SizeChanged="Panel_SizeChanged" AutomationProperties.Name="Pengingat">
                    <StackPanel.RenderTransform>
                        <TranslateTransform />
                    </StackPanel.RenderTransform>
                    <Grid Height="18">
                        <TextBlock Style="{StaticResource IslandMeta}" HorizontalAlignment="Left" Text="{local:Tr Pengingat, En=Reminders}" />
                        <TextBlock x:Name="ReminderCount" Style="{StaticResource IslandMeta}" HorizontalAlignment="Right" />
                    </Grid>
                    <Grid Height="64" Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="ReminderTitle" Style="{StaticResource IslandTitle}" />
                            <TextBlock x:Name="ReminderSub" Style="{StaticResource IslandMeta}" FontWeight="Normal" Margin="1,2,0,0" />
                        </StackPanel>
                        <Button x:Name="ReminderSnooze" Grid.Column="1" Style="{StaticResource IslandChip}" Margin="12,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"
                                Content="{local:Tr Tunda 10m, En=Snooze 10m}" Click="ReminderSnooze_Click" />
                        <Button x:Name="ReminderDone" Grid.Column="2" Style="{StaticResource IslandRoundButton}" Background="#F5F5F7" Height="40" Margin="12,0,0,0" VerticalAlignment="Center" Click="ReminderDone_Click" AutomationProperties.Name="Selesai" ToolTip="{local:Tr Selesai, En=Done}">
                            <Path Stroke="Black" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M 1,7 L 5.5,11.5 L 14,2" />
                        </Button>
                    </Grid>
                    <ScrollViewer Height="80" Margin="0,10,0,0" VerticalScrollBarVisibility="Hidden">
                        <StackPanel x:Name="ReminderRows" />
                    </ScrollViewer>
                    <Border Height="40" BorderBrush="#14FFFFFF" BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Path Stroke="#7C7C80" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 7,0 L 7,14 M 0,7 L 14,7" VerticalAlignment="Center" Margin="1,0,0,0" />
                            <TextBlock x:Name="ReminderHint" Grid.Column="1" Foreground="#7C7C80" FontSize="14" FontWeight="Medium" VerticalAlignment="Center" IsHitTestVisible="False" TextTrimming="CharacterEllipsis"
                                       Text="{local:Tr 15m minum air · 14:30 telepon · beli susu, En=15m drink water · 14:30 call · buy milk}" />
                            <TextBox x:Name="ReminderInput" Grid.Column="1" Style="{StaticResource NotchInput}" FontSize="14" VerticalAlignment="Center"
                                     KeyDown="ReminderInput_KeyDown" TextChanged="ReminderInput_TextChanged"
                                     AutomationProperties.Name="Tambah pengingat" />
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Weather where the user is, and other time zones. -->
                <StackPanel x:Name="WeatherPanel" Margin="16" Width="388" HorizontalAlignment="Center" VerticalAlignment="Top" Visibility="Collapsed" SizeChanged="Panel_SizeChanged" AutomationProperties.Name="Cuaca dan jam dunia">
                    <StackPanel.RenderTransform>
                        <TranslateTransform />
                    </StackPanel.RenderTransform>
                    <Grid Height="18">
                        <TextBlock x:Name="WeatherPlace" Style="{StaticResource IslandMeta}" HorizontalAlignment="Left" Text="{local:Tr Cuaca, En=Weather}" />
                        <TextBlock x:Name="WeatherSummary" Style="{StaticResource IslandMeta}" HorizontalAlignment="Right" MaxWidth="240" />
                    </Grid>
                    <Grid x:Name="WeatherNow" Height="64" Margin="0,4,0,0">
                        <TextBlock x:Name="WeatherTemp" Style="{StaticResource IslandHero}" />
                        <Border Width="40" Height="40" CornerRadius="20" Background="#1C1C1E" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Path x:Name="WeatherIcon" Width="20" Height="20" Stretch="Uniform" Stroke="#F5F5F7" StrokeThickness="1.8"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                    <TextBlock x:Name="WeatherMessage" Style="{StaticResource IslandTitle}" FontSize="17" Height="64" Margin="0,4,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
                    <Grid Height="72" Margin="-16,8,0,0">
                        <local:Sparkline x:Name="WeatherLine" />
                    </Grid>
                    <local:SpaceBetweenPanel x:Name="WorldClockRows" Height="38" Margin="0,12,0,0" />
                </StackPanel>

                <!-- Today (Page 2, board 02, D1): the date is the title; rows 56 with 40 items; P 16 all round, the last row ends 8 above the edge. -->
                <StackPanel x:Name="TodayPanel" Width="388" Margin="16" HorizontalAlignment="Center" VerticalAlignment="Top"
                            Visibility="Collapsed" SizeChanged="Panel_SizeChanged" AutomationProperties.Name="Hari ini">
                    <StackPanel.RenderTransform>
                        <TranslateTransform />
                    </StackPanel.RenderTransform>
                    <Grid Height="18">
                        <TextBlock x:Name="TodayDay" Style="{StaticResource IslandMeta}" HorizontalAlignment="Left" />
                        <TextBlock x:Name="TodayMeta" Style="{StaticResource IslandMeta}" HorizontalAlignment="Right" MaxWidth="240" />
                    </Grid>
                    <Grid Height="64" Margin="0,4,0,0">
                        <TextBlock x:Name="TodayDate" Style="{StaticResource IslandHero}" />
                        <Button Style="{StaticResource IslandRoundButton}" Background="#F5F5F7" Height="40" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Click="TodayAdd_Click" AutomationProperties.Name="Tambah pengingat" ToolTip="{local:Tr Tambah pengingat, En=Add a reminder}">
                            <Path Stroke="Black" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 7,0 L 7,14 M 0,7 L 14,7" />
                        </Button>
                    </Grid>
                    <ScrollViewer Height="120" Margin="0,10,0,0" VerticalScrollBarVisibility="Hidden">
                        <StackPanel x:Name="TodayRows" />
                    </ScrollViewer>
                </StackPanel>

                <!-- Control Center (board 34): eight 40 tiles, then volume and brightness as liquid capsules. -->
                <StackPanel x:Name="ControlPanel" Margin="16" Width="388" HorizontalAlignment="Center" VerticalAlignment="Top"
                            Visibility="Collapsed" SizeChanged="Panel_SizeChanged" AutomationProperties.Name="Pusat kontrol">
                    <StackPanel.RenderTransform>
                        <TranslateTransform />
                    </StackPanel.RenderTransform>
                    <Grid Height="18">
                        <TextBlock x:Name="ControlLabel" Style="{StaticResource IslandMeta}" HorizontalAlignment="Left" Text="{local:Tr Kontrol, En=Control}" />
                        <TextBlock x:Name="ControlMeta" Style="{StaticResource IslandMeta}" HorizontalAlignment="Right" />
                    </Grid>
                    <StackPanel Height="64" Margin="0,4,0,0">
                        <TextBlock x:Name="ControlTitle" Style="{StaticResource IslandTitle}" />
                        <TextBlock x:Name="ControlSub" Style="{StaticResource IslandMeta}" FontWeight="Normal" Margin="1,2,0,0" />
                    </StackPanel>
                    <local:SpaceBetweenPanel x:Name="ControlTiles" Height="40" Margin="0,10,0,0" />
                    <StackPanel x:Name="ControlSliders" Margin="0,8,0,0" />
                </StackPanel>


                <!-- Water: today's glasses against the goal, the last seven days, and one-click glasses. -->
                <StackPanel x:Name="WaterPanel" Margin="16" Width="388" HorizontalAlignment="Center" VerticalAlignment="Top" Visibility="Collapsed" SizeChanged="Panel_SizeChanged" AutomationProperties.Name="Minum air">
                    <StackPanel.RenderTransform>
                        <TranslateTransform />
                    </StackPanel.RenderTransform>
                    <Grid Height="18">
                        <TextBlock Style="{StaticResource IslandMeta}" HorizontalAlignment="Left" Text="{local:Tr Air, En=Water}" />
                        <TextBlock x:Name="WaterNext" Style="{StaticResource IslandMeta}" HorizontalAlignment="Right" MaxWidth="280" />
                    </Grid>
                    <Grid Height="64" Margin="0,4,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="WaterToday" Style="{StaticResource IslandHero}" />
                            <TextBlock Style="{StaticResource IslandHeroUnit}" Text="ml" />
                        </StackPanel>
                        <Button x:Name="WaterAdd" Style="{StaticResource IslandRoundButton}" Background="#F5F5F7" Height="40" HorizontalAlignment="Right" VerticalAlignment="Center" Click="WaterAdd_Click">
                            <Path Stroke="Black" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 7,0 L 7,14 M 0,7 L 14,7" />
                        </Button>
                    </Grid>
                    <Grid x:Name="WaterWeek" Height="66" Margin="-4,10,-4,0" />
                    <local:SpaceBetweenPanel Height="38" Margin="0,16,0,0">
                        <StackPanel><TextBlock Style="{StaticResource IslandFootLabel}" Foreground="#7C7C80" Text="{local:Tr Target, En=Goal}" /><TextBlock x:Name="WaterGoal" Style="{StaticResource IslandFootValue}" Foreground="#98989F" /></StackPanel>
                        <StackPanel><TextBlock Style="{StaticResource IslandFootLabel}" Foreground="#7C7C80" Text="{local:Tr Sisa, En=Left}" /><TextBlock x:Name="WaterLeft" Style="{StaticResource IslandFootValue}" Foreground="#98989F" /></StackPanel>
                        <StackPanel><TextBlock Style="{StaticResource IslandFootLabel}" Foreground="#7C7C80" Text="{local:Tr Gelas, En=Glasses}" /><TextBlock x:Name="WaterGlasses" Style="{StaticResource IslandFootValue}" Foreground="#98989F" /></StackPanel>
                        <Button x:Name="WaterUndo" Style="{StaticResource IslandFootButton}" Click="WaterUndo_Click">
                            <StackPanel>
                                <TextBlock Style="{StaticResource IslandFootLabel}" HorizontalAlignment="Right" Text="{local:Tr Urungkan, En=Undo}" />
                                <TextBlock x:Name="WaterUndoValue" Style="{StaticResource IslandFootValue}" HorizontalAlignment="Right" />
                            </StackPanel>
                        </Button>
                    </local:SpaceBetweenPanel>
                </StackPanel>

                <!-- A selection caught by the quick-capture hotkey, and what to do with it. -->
                <StackPanel x:Name="SelectionPanel" Margin="16" Width="388" HorizontalAlignment="Center" VerticalAlignment="Top"
                            Visibility="Collapsed" SizeChanged="Panel_SizeChanged" Focusable="True" FocusVisualStyle="{x:Null}"
                            KeyDown="SelectionPanel_KeyDown" AutomationProperties.Name="Teks terpilih">
                    <StackPanel.RenderTransform>
                        <TranslateTransform />
                    </StackPanel.RenderTransform>
                    <Grid Height="18">
                        <TextBlock Style="{StaticResource IslandMeta}" HorizontalAlignment="Left" Text="{local:Tr Teks terpilih, En=Selected text}" />
                        <TextBlock x:Name="SelectionMeta" Style="{StaticResource IslandMeta}" HorizontalAlignment="Right" />
                    </Grid>
                    <Border Height="88" Margin="0,4,0,0" Background="#1C1C1E" CornerRadius="16" Padding="12,10">
                        <TextBlock x:Name="SelectionPreview" FontSize="15" FontWeight="Medium" LineHeight="22" Foreground="#F5F5F7" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                    </Border>
                    <StackPanel x:Name="SelectionButtons" Margin="0,8,0,0" />
                </StackPanel>

                <!-- Launcher: the notch drops down into a prompt + recent threads. -->
                <StackPanel x:Name="LauncherPanel" Margin="10" Width="540" HorizontalAlignment="Center" VerticalAlignment="Top"
                            Visibility="Collapsed" SizeChanged="Panel_SizeChanged">
                    <StackPanel.RenderTransform>
                        <TranslateTransform />
                    </StackPanel.RenderTransform>
                    <Border Height="50" CornerRadius="18" Background="{StaticResource NotchFill}" Padding="8,0,8,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <!-- Provider dropdown: the real logo, the name, a chevron. -->
                            <Button x:Name="ProviderButton" Style="{StaticResource NotchProviderButton}" Margin="0,0,12,0"
                                    Click="ProviderButton_Click" AutomationProperties.Name="Pilih provider">
                                <StackPanel Orientation="Horizontal">
                                    <Path x:Name="ProviderLogo" Width="16" Height="16" Stretch="Uniform" Fill="White" VerticalAlignment="Center" />
                                    <TextBlock x:Name="LauncherProviderText" Text="Codex" Margin="7,0,7,0" VerticalAlignment="Center" />
                                    <Path Stroke="#8CFFFFFF" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Data="M 1,1 L 4.5,4.5 L 8,1" VerticalAlignment="Center" Margin="0,1,0,0" />
                                </StackPanel>
                            </Button>
                            <Popup x:Name="ProviderPopup" PlacementTarget="{Binding ElementName=ProviderButton}" Placement="Bottom"
                                   VerticalOffset="8" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                                <Border Background="#FF1C1C1E" CornerRadius="14" Padding="6" MinWidth="230"
                                        BorderBrush="#33FFFFFF" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock x:Name="ProviderPopupHeader" FontSize="11" Foreground="{StaticResource NotchText3}" Margin="10,6,10,6" />
                                        <StackPanel x:Name="ProviderList" />
                                    </StackPanel>
                                </Border>
                            </Popup>
                            <TextBlock x:Name="LauncherPlaceholder" Grid.Column="1" Text="Tanya Codex, atau cari thread" FontSize="15"
                                       Foreground="{StaticResource NotchText3}" VerticalAlignment="Center" IsHitTestVisible="False" />
                            <Grid x:Name="LauncherSuggestion" Grid.Column="1" IsHitTestVisible="False" Visibility="Collapsed" Margin="0,0,8,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="LauncherSuggestionText" FontSize="15" Foreground="#61FFFFFF" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="LauncherSuggestionAi" Text="✦" Foreground="#BF9BFF" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <Border Height="20" CornerRadius="6" BorderBrush="#38FFFFFF" BorderThickness="1" Padding="6,0" VerticalAlignment="Center">
                                        <TextBlock Text="Tab" FontSize="10" Foreground="#99FFFFFF" VerticalAlignment="Center" />
                                    </Border>
                                </StackPanel>
                            </Grid>
                            <TextBox x:Name="LauncherInput" Grid.Column="1" Style="{StaticResource NotchInput}" FontSize="15"
                                     TextChanged="LauncherInput_TextChanged" PreviewKeyDown="LauncherInput_PreviewKeyDown"
                                     AutomationProperties.Name="Tanya atau cari thread" />
                            <!-- Recording / transcribing state, drawn over the input. -->
                            <Grid x:Name="LauncherVoiceHost" Grid.Column="1" Visibility="Collapsed" Background="Transparent" />
                            <Button x:Name="MicButton" Grid.Column="2" Style="{StaticResource NotchIconButton}" Margin="0,0,2,0"
                                    PreviewMouseLeftButtonDown="MicButton_Down" PreviewMouseLeftButtonUp="MicButton_Up"
                                    AutomationProperties.Name="Input suara">
                                <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="14" Height="17" Stretch="None"
                                      Data="M 7,1.2 Q 9.6,1.2 9.6,3.8 L 9.6,8.2 Q 9.6,10.8 7,10.8 Q 4.4,10.8 4.4,8.2 L 4.4,3.8 Q 4.4,1.2 7,1.2 Z M 1.8,7.6 Q 1.8,13.2 7,13.2 Q 12.2,13.2 12.2,7.6 M 7,13.2 L 7,16" />
                            </Button>
                            <Button x:Name="ScreenshotButton" Grid.Column="3" Style="{StaticResource NotchIconButton}" Margin="0,0,6,0"
                                    Click="ScreenshotButton_Click" AutomationProperties.Name="Screenshot">
                                <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5"
                                      StrokeLineJoin="Round" Width="18" Height="16" Stretch="None"
                                      Data="M 1.5,4.5 L 1.5,13 Q 1.5,14.5 3,14.5 L 15,14.5 Q 16.5,14.5 16.5,13 L 16.5,4.5 Q 16.5,3 15,3 L 12.5,3 L 11.3,1.2 L 6.7,1.2 L 5.5,3 L 3,3 Q 1.5,3 1.5,4.5 Z M 12,8.6 A 3,3 0 1 1 6,8.6 A 3,3 0 1 1 12,8.6 Z" />
                            </Button>
                            <Button x:Name="LauncherSendButton" Grid.Column="4" Style="{StaticResource NotchRoundButton}" Width="34" Height="34"
                                    Click="LauncherSendButton_Click" IsEnabled="False" AutomationProperties.Name="Kirim">
                                <Path Stroke="Black" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Data="M 7,12 L 7,2 M 2.5,6.5 L 7,2 L 11.5,6.5" Width="14" Height="14" />
                            </Button>
                        </Grid>
                    </Border>

                    <Border x:Name="VoiceSetup" Margin="0,8,0,0" CornerRadius="14" Background="#12FFFFFF" Padding="14,12" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="VoiceSetupTitle" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock x:Name="VoiceSetupText" FontSize="12" Margin="0,3,0,0" Foreground="{StaticResource NotchText2}" TextWrapping="Wrap" />
                            <Grid Margin="0,10,0,0">
                                <Border x:Name="VoiceProgressTrack" Height="4" CornerRadius="2" Background="#1FFFFFFF" VerticalAlignment="Center"
                                        Visibility="Collapsed" Margin="0,0,12,0">
                                    <Border x:Name="VoiceProgressFill" HorizontalAlignment="Left" Width="0" CornerRadius="2" Background="White" />
                                </Border>
                                <StackPanel x:Name="VoiceSetupButtons" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button x:Name="VoiceLaterButton" Style="{StaticResource NotchPill}" Click="VoiceLater_Click" />
                                    <Button x:Name="VoiceDownloadButton" Style="{StaticResource NotchPrimaryPill}" Click="VoiceDownload_Click" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Files dragged over the notch: attach them to the prompt, or keep them on the shelf. -->
                    <Grid x:Name="DropZone" Margin="0,8,0,0" Height="72" Visibility="Collapsed" IsHitTestVisible="False">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="DropAttachZone" CornerRadius="14" Background="#0FFFFFFF">
                            <Grid>
                                <Rectangle x:Name="DropAttachEdge" RadiusX="14" RadiusY="14" Stroke="#59FFFFFF" StrokeThickness="1.2" StrokeDashArray="4 3" />
                                <Path x:Name="DropAttachIcon" Stroke="White" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Width="18" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Data="M 13,6 L 6,13 Q 4,15 6,17 Q 8,19 10,17 L 17,10 Q 20,7 17,4 Q 14,1 11,4 L 4,11 Q 0,15 4,19 Q 8,23 12,19 L 17,14" />
                                <TextBlock x:Name="DropZoneText" Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <Border x:Name="DropShelfZone" Grid.Column="2" CornerRadius="14" Background="#0FFFFFFF">
                            <Grid>
                                <Rectangle x:Name="DropShelfEdge" RadiusX="14" RadiusY="14" Stroke="#59FFFFFF" StrokeThickness="1.2" StrokeDashArray="4 3" />
                                <Path Stroke="White" StrokeThickness="1.9" StrokeLineJoin="Round" Width="26" Height="22" Stretch="Uniform"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" Data="M 2,14 L 6,3 L 24,3 L 28,14 L 28,22 Q 28,24 26,24 L 4,24 Q 2,24 2,22 Z M 2,14 L 9,14 L 11,17 L 19,17 L 21,14 L 28,14" />
                            </Grid>
                        </Border>
                    </Grid>
                    <WrapPanel x:Name="AttachmentTray" Margin="0,8,0,0" Visibility="Collapsed" />

                    <!-- A request waiting for the user, with its recommended answer. -->
                    <StackPanel x:Name="WaitingPanel" Visibility="Collapsed">
                        <TextBlock x:Name="WaitingHeader" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource NotchOrange}" Margin="12,14,12,6" />
                        <StackPanel x:Name="WaitingList" />
                    </StackPanel>

                    <!-- Parallel agents (running or finished, until closed). -->
                    <StackPanel x:Name="AgentListPanel" Visibility="Collapsed">
                        <TextBlock x:Name="AgentHeader" Text="Agent paralel" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource NotchText3}" Margin="12,12,12,4" />
                        <StackPanel x:Name="AgentList" />
                    </StackPanel>

                    <Grid Margin="12,12,8,4">
                        <TextBlock x:Name="RecentHeader" Text="Lanjutkan" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource NotchText3}" VerticalAlignment="Center" />
                        <!-- Source filters when sessions from elsewhere are listed (Terminal · IDE · Desktop · TheAI). -->
                        <StackPanel x:Name="RecentFilters" Orientation="Horizontal" HorizontalAlignment="Right" />
                    </Grid>
                    <ItemsControl x:Name="RecentList" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource NotchRowButton}" Click="RecentItem_Click" Tag="{Binding}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Width="6" Height="6" Fill="{Binding Dot}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding Meta}" FontSize="11" Margin="12,0,0,0"
                                                   Foreground="{StaticResource NotchText3}" VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- "/" turns the launcher into a command palette. -->
                    <StackPanel x:Name="CommandPanel" Visibility="Collapsed" Margin="0,8,0,0" AutomationProperties.Name="Perintah">
                        <StackPanel x:Name="CommandRows" />
                        <TextBlock x:Name="CommandEmpty" Visibility="Collapsed" Margin="12,6,12,2" FontSize="12" Foreground="{StaticResource NotchText3}"
                                   TextWrapping="Wrap" Text="{local:Tr Tidak ada perintah seperti itu — hapus / untuk bertanya biasa., En=No such command — remove the / to just ask.}" />
                        <TextBlock Margin="12,8,12,0" FontSize="11" Foreground="{StaticResource NotchText3}"
                                   Text="{local:Tr ↑↓ pilih · Tab lengkapi · Enter jalankan, En=↑↓ choose · Tab complete · Enter run}" />
                    </StackPanel>

                    <WrapPanel x:Name="ChipPanel" Margin="6,10,6,0" />

                    <!-- Subscription usage: one row per limit window. -->
                    <StackPanel x:Name="QuotaPanel" Margin="12,12,12,0" Visibility="Collapsed" />

                    <!-- Grabber: tap, or pull toward the screen edge, to fold the launcher back into the notch. -->
                    <Button x:Name="LauncherGrabber" Style="{StaticResource NotchGrabber}" Margin="0,10,0,0" HorizontalAlignment="Center"
                            Click="LauncherGrabber_Click" PreviewMouseLeftButtonDown="LauncherGrabber_Down"
                            PreviewMouseMove="LauncherGrabber_Move" AutomationProperties.Name="Tutup" />
                </StackPanel>

                <!-- Quick: a request arriving while the notch is compact; one click for the recommended answer. -->
                <StackPanel x:Name="QuickPanel" Margin="16" MinHeight="88" Width="388" HorizontalAlignment="Center" VerticalAlignment="Top"
                            Visibility="Collapsed" SizeChanged="Panel_SizeChanged">
                    <TextBlock x:Name="QuickKind" Style="{StaticResource IslandMeta}" />
                    <TextBlock x:Name="QuickText" Style="{StaticResource IslandTitle}" Margin="-1,4,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button x:Name="QuickPrimary" Style="{StaticResource IslandPrimaryButton}" Margin="0" Click="QuickPrimary_Click" />
                        <Button x:Name="QuickSecondary" Style="{StaticResource IslandButton}" Margin="8,0,0,0" Click="QuickSecondary_Click" />
                        <Button x:Name="QuickMore" Style="{StaticResource IslandRoundButton}" Margin="8,0,0,0" Click="QuickMore_Click"
                                ToolTip="Pilihan lain" AutomationProperties.Name="Pilihan lain">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="3.5" Height="3.5" Fill="White" />
                                <Ellipse Width="3.5" Height="3.5" Fill="White" Margin="3,0,0,0" />
                                <Ellipse Width="3.5" Height="3.5" Fill="White" Margin="3,0,0,0" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>

                <!-- Request: an approval or a question from the agent, answered right here. -->
                <StackPanel x:Name="RequestPanel" Margin="16" Width="388" HorizontalAlignment="Center" VerticalAlignment="Top"
                            Visibility="Collapsed" SizeChanged="Panel_SizeChanged">
                    <!-- Board 34: a dot, who is asking, how long it has waited; the question; the command; three 40 buttons. -->
                    <Grid Height="18">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="RequestDot" Width="8" Height="8" Fill="#FFD60A" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="RequestKind" Style="{StaticResource IslandMeta}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock x:Name="RequestCountdown" Style="{StaticResource IslandMeta}" Margin="0,0,8,0" />
                            <TextBlock x:Name="RequestContext" Style="{StaticResource IslandMeta}" MaxWidth="180" />
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="RequestTitle" Style="{StaticResource IslandTitle}" Margin="-1,4,0,0" />
                    <Grid Height="18" Margin="0,2,0,0">
                        <TextBlock x:Name="RequestMessage" Style="{StaticResource IslandMeta}" FontWeight="Normal" />
                        <Button x:Name="RequestLink" Style="{StaticResource NotchTextLink}" HorizontalAlignment="Right" Click="RequestLink_Click" />
                    </Grid>
                    <Border x:Name="RequestDetailBox" Margin="0,14,0,0" Background="#1C1C1E" CornerRadius="16" Padding="12,10" Height="64">
                        <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                            <TextBlock x:Name="RequestDetail" FontFamily="Cascadia Mono, Consolas" FontSize="13" LineHeight="22"
                                       Foreground="#F5F5F7" TextWrapping="Wrap" />
                        </ScrollViewer>
                    </Border>
                    <StackPanel x:Name="RequestFields" Margin="0,14,0,0" />
                    <TextBlock x:Name="RequestError" Margin="0,8,0,0" FontSize="12" Foreground="#FF6B61" TextWrapping="Wrap" Visibility="Collapsed" />
                    <UniformGrid Rows="1" Margin="0,16,-8,0">
                        <Button x:Name="RequestTertiary" Style="{StaticResource IslandButton}" Margin="0,0,8,0" Click="RequestTertiary_Click" />
                        <Button x:Name="RequestSecondary" Style="{StaticResource IslandButton}" Margin="0,0,8,0" Click="RequestSecondary_Click" />
                        <Button x:Name="RequestPrimary" Style="{StaticResource IslandPrimaryButton}" Margin="0,0,8,0" Click="RequestPrimary_Click" />
                    </UniformGrid>
                </StackPanel>

                <!-- Activity: steps + live output of the running (or last) turn. -->
                <StackPanel x:Name="ActivityPanel" Margin="16" Width="388" HorizontalAlignment="Center" VerticalAlignment="Top"
                            Visibility="Collapsed" SizeChanged="Panel_SizeChanged" Background="Transparent"
                            MouseEnter="ActivityPanel_MouseEnter" MouseLeave="ActivityPanel_MouseLeave">
                    <StackPanel.RenderTransform>
                        <TranslateTransform />
                    </StackPanel.RenderTransform>
                    <Grid Height="18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                            <Run x:Name="ActivityProviderRun" Text="Codex" FontSize="13" FontWeight="Medium" Foreground="#98989F" />
                            <Run x:Name="ActivityContextRun" Text="  TheAI" FontSize="13" FontWeight="Medium" Foreground="#7C7C80" />
                        </TextBlock>
                        <StackPanel x:Name="ActivityTools" Grid.Column="1" Orientation="Horizontal" Opacity="0">
                            <StackPanel x:Name="ActivityPager" Orientation="Horizontal" Margin="0,0,6,0" Visibility="Collapsed">
                                <Button Style="{StaticResource NotchIconButton}" Width="24" Click="PrevActivity_Click" AutomationProperties.Name="Agent sebelumnya">
                                    <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M 6,1 L 2,5 L 6,9" />
                                </Button>
                                <TextBlock x:Name="ActivityPagerText" FontSize="11" Foreground="{StaticResource NotchText3}"
                                           VerticalAlignment="Center" Margin="2,0" FontFamily="Segoe UI Variable Text, Segoe UI" />
                                <Button Style="{StaticResource NotchIconButton}" Width="24" Click="NextActivity_Click" AutomationProperties.Name="Agent berikutnya">
                                    <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M 2,1 L 6,5 L 2,9" />
                                </Button>
                            </StackPanel>
                            <Button x:Name="PinButton" Style="{StaticResource NotchIconButton}" Click="PinButton_Click" ToolTip="Sematkan" AutomationProperties.Name="Sematkan">
                                <Path x:Name="PinGlyph" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Data="M 5,1.5 L 10,1.5 L 9.2,6.5 L 11.5,9 L 3.5,9 L 5.8,6.5 Z M 7.5,9 L 7.5,14" Width="15" Height="15" />
                            </Button>
                            <Button Style="{StaticResource NotchIconButton}" Click="OpenWindowButton_Click" ToolTip="Buka di jendela" AutomationProperties.Name="Buka di jendela">
                                <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Data="M 9,2 L 13,2 L 13,6 M 13,2 L 8,7 M 6,3 L 3,3 L 3,13 L 13,13 L 13,10" Width="15" Height="15" />
                            </Button>
                            <Button Style="{StaticResource NotchIconButton}" Click="CloseButton_Click" ToolTip="Tutup" AutomationProperties.Name="Tutup">
                                <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Data="M 3.5,3.5 L 11.5,11.5 M 11.5,3.5 L 3.5,11.5" Width="15" Height="15" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <TextBlock x:Name="ActivityPrompt" Style="{StaticResource IslandTitle}" Margin="-1,4,0,0" />

                    <ItemsControl x:Name="StepList" Margin="0,10,0,0" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="14" Height="14" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <Path Visibility="{Binding DoneVisibility}" Stroke="#32D74B" StrokeThickness="2.2"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              Data="M 2.5,7.5 L 5.6,10.4 L 11.5,3.8" />
                                        <Ellipse Visibility="{Binding ActiveVisibility}" Width="11" Height="11" Stroke="#32D74B" StrokeThickness="2" />
                                    </Grid>
                                    <TextBlock Grid.Column="1" Text="{Binding Text}" Foreground="{Binding Brush}" FontSize="13"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border x:Name="OutputBox" Margin="0,4,0,0" Background="#12FFFFFF" CornerRadius="12" Padding="12,9" Visibility="Collapsed">
                        <TextBlock x:Name="OutputText" FontFamily="Cascadia Mono, Consolas" FontSize="12" LineHeight="19"
                                   Foreground="#B3FFFFFF" TextWrapping="Wrap" MaxHeight="134" />
                    </Border>

                    <!-- Files the agent changed this turn: summary row, expands into a list with diffs. -->
                    <Border x:Name="FilesBox" Margin="0,8,0,0" Background="#12FFFFFF" CornerRadius="12" Visibility="Collapsed">
                        <StackPanel>
                            <Grid Height="38">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="FilesHeaderButton" Style="{StaticResource NotchRowButton}" Height="38" Click="FilesHeader_Click"
                                        AutomationProperties.Name="File yang diubah">
                                    <StackPanel Orientation="Horizontal">
                                        <Path x:Name="FilesChevron" Stroke="{StaticResource NotchText3}" StrokeThickness="1.6" Width="10" Height="10"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              Data="M 3,1.5 L 7,5 L 3,8.5" RenderTransformOrigin="0.5,0.5" Margin="0,0,10,0" VerticalAlignment="Center">
                                            <Path.RenderTransform>
                                                <RotateTransform x:Name="FilesChevronRotation" />
                                            </Path.RenderTransform>
                                        </Path>
                                        <TextBlock x:Name="FilesSummary" FontSize="13" VerticalAlignment="Center" />
                                        <TextBlock x:Name="FilesAdded" FontSize="12" Margin="10,0,0,0" Foreground="{StaticResource NotchGreen}"
                                                   FontFamily="Cascadia Mono, Consolas" VerticalAlignment="Center" />
                                        <TextBlock x:Name="FilesRemoved" FontSize="12" Margin="6,0,0,0" Foreground="{StaticResource NotchRed}"
                                                   FontFamily="Cascadia Mono, Consolas" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="OpenEditorButton" Grid.Column="1" Style="{StaticResource NotchTextLink}" Margin="8,0,14,0"
                                        Click="OpenEditor_Click" Content="Buka di VS Code" />
                            </Grid>
                            <ScrollViewer x:Name="FilesScroller" MaxHeight="232" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed" Focusable="False">
                                <StackPanel x:Name="FilesList" Margin="4,0,4,6" />
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                    <!-- Prompts waiting for the current turn to finish. -->
                    <StackPanel x:Name="QueueBox" Margin="0,10,0,0" Visibility="Collapsed">
                        <Grid Height="22" Margin="2,0,0,2">
                            <TextBlock VerticalAlignment="Center">
                                <Run x:Name="QueueTitleRun" Text="Antrean" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource NotchText3}" />
                                <Run x:Name="QueueStateRun" FontSize="11" Foreground="{StaticResource NotchOrange}" />
                            </TextBlock>
                            <Button x:Name="QueueSendNowButton" Style="{StaticResource NotchTextLink}" HorizontalAlignment="Right"
                                    Click="QueueSendNow_Click" Content="Kirim sekarang" Visibility="Collapsed" />
                        </Grid>
                        <StackPanel x:Name="QueueList" />
                    </StackPanel>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Height="38" CornerRadius="19" Background="#17FFFFFF" Padding="16,0">
                            <Grid>
                                <TextBlock x:Name="FollowUpPlaceholder" Text="Tambahkan instruksi…" Foreground="{StaticResource NotchText3}"
                                           VerticalAlignment="Center" IsHitTestVisible="False" />
                                <!-- Next-prompt suggestion: Tab takes it, Enter sends it. -->
                                <Grid x:Name="FollowUpSuggestion" IsHitTestVisible="False" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="FollowUpSuggestionText" Foreground="#61FFFFFF" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="FollowUpSuggestionAi" Text="✦" Foreground="#BF9BFF" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <Border Height="20" CornerRadius="6" BorderBrush="#38FFFFFF" BorderThickness="1" Padding="6,0" VerticalAlignment="Center">
                                            <TextBlock Text="Tab" FontSize="10" Foreground="#99FFFFFF" VerticalAlignment="Center" />
                                        </Border>
                                    </StackPanel>
                                </Grid>
                                <TextBox x:Name="FollowUpInput" Style="{StaticResource NotchInput}"
                                         TextChanged="FollowUpInput_TextChanged" PreviewKeyDown="FollowUpInput_PreviewKeyDown"
                                         AutomationProperties.Name="Tambahkan instruksi" />
                                <Grid x:Name="FollowUpVoiceHost" Visibility="Collapsed" Background="Transparent" />
                            </Grid>
                        </Border>
                        <Button x:Name="ActionButton" Grid.Column="1" Width="38" Height="38" Margin="8,0,0,0"
                                Style="{StaticResource NotchRoundButton}" Click="ActionButton_Click" AutomationProperties.Name="Hentikan">
                            <Grid>
                                <Border x:Name="StopGlyph" Width="12" Height="12" CornerRadius="3" Background="Black" />
                                <Path x:Name="SendGlyph" Visibility="Collapsed" Stroke="Black" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Data="M 7,12 L 7,2 M 2.5,6.5 L 7,2 L 11.5,6.5" Width="14" Height="14" />
                            </Grid>
                        </Button>
                    </Grid>
                </StackPanel>
            </local:UnclampedGrid>
            <!-- Music and the agent are two pages: scrolling switches between them. -->
            <StackPanel x:Name="PageDots" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,1"
                        Visibility="Collapsed" IsHitTestVisible="False">
            </StackPanel>
            </Grid>
        </Border>
    </Grid>
    </Grid>
</Window>
