<Window x:Class="CodexBar.App.NotchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CodexBar.App"
        Title="CodexBar Notch"
        AutomationProperties.Name="CodexBar notch"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Width="720"
        Height="640"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="13"
        Foreground="White"
        Deactivated="Window_Deactivated"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <SolidColorBrush x:Key="NotchText" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="NotchText2" Color="#BFFFFFFF" />
        <SolidColorBrush x:Key="NotchText3" Color="#80FFFFFF" />
        <SolidColorBrush x:Key="NotchFill" Color="#1AFFFFFF" />
        <SolidColorBrush x:Key="NotchFillHover" Color="#24FFFFFF" />
        <SolidColorBrush x:Key="NotchAccent" Color="#0A84FF" />
        <SolidColorBrush x:Key="NotchGreen" Color="#30D158" />
        <SolidColorBrush x:Key="NotchOrange" Color="#FF9F0A" />
        <SolidColorBrush x:Key="NotchRed" Color="#FF453A" />

        <Style x:Key="NotchIconButton" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Foreground" Value="{StaticResource NotchText2}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource NotchFill}" />
                                <Setter Property="Foreground" Value="{StaticResource NotchText}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NotchRowButton" TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{StaticResource NotchText2}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="10" Padding="12,0">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource NotchFill}" />
                                <Setter Property="Foreground" Value="{StaticResource NotchText}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource NotchFill}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NotchChip" TargetType="Button">
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Foreground" Value="{StaticResource NotchText2}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="#14FFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="0.5" CornerRadius="14" Padding="12,0">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource NotchFillHover}" />
                                <Setter Property="Foreground" Value="{StaticResource NotchText}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NotchRoundButton" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="White" CornerRadius="99">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#E6FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Background" Value="#40FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NotchProviderButton" TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="#14FFFFFF" CornerRadius="12" Padding="9,0,10,0">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#26FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NotchGrabber" TargetType="Button">
            <Setter Property="Width" Value="72" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Border x:Name="Bar" Width="36" Height="5" CornerRadius="2.5" Background="#47FFFFFF" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bar" Property="Background" Value="#80FFFFFF" />
                                <Setter TargetName="Bar" Property="Width" Value="44" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NotchInput" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="CaretBrush" Value="White" />
            <Setter Property="SelectionBrush" Value="#0A84FF" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Request view (approvals / agent questions) -->
        <Style x:Key="NotchPill" TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="#1FFFFFFF" CornerRadius="16" Padding="16,0">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#33FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NotchPrimaryPill" TargetType="Button" BasedOn="{StaticResource NotchPill}">
            <Setter Property="Foreground" Value="Black" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="White" CornerRadius="16" Padding="16,0">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#E6FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NotchTextLink" TargetType="Button">
            <Setter Property="Foreground" Value="#99FFFFFF" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter VerticalAlignment="Center" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NotchOption" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="#D9FFFFFF" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bg" Background="#14FFFFFF" BorderBrush="Transparent" BorderThickness="1.5" CornerRadius="12" Padding="12,8">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1FFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="White" />
                                <Setter TargetName="Bg" Property="Background" Value="#24FFFFFF" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NotchSecret" TargetType="PasswordBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="CaretBrush" Value="White" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Transparent margin gives the drop shadow room; transparent pixels are click-through. -->
    <Grid>
    <!-- Gooey liquid drawn while the compact notch is being dragged (see NotchWindow.Liquid.cs). -->
    <Image x:Name="LiquidImage" Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Top"
           IsHitTestVisible="False" Visibility="Collapsed" RenderOptions.BitmapScalingMode="NearestNeighbor" />
    <Grid x:Name="Root" Margin="28,0,28,36">
        <Border x:Name="Shell"
                Background="Black"
                AllowDrop="True"
                DragEnter="Shell_DragEnter"
                DragOver="Shell_DragOver"
                DragLeave="Shell_DragLeave"
                Drop="Shell_Drop"
                CornerRadius="0,0,14,14"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                ClipToBounds="True"
                MouseEnter="Shell_MouseEnter"
                MouseLeave="Shell_MouseLeave"
                MouseLeftButtonDown="Shell_MouseLeftButtonDown"
                MouseMove="Shell_MouseMove"
                MouseLeftButtonUp="Shell_MouseLeftButtonUp">

            <Grid x:Name="ShellRoot">
            <!-- Corner-docked L shape (Border background is cleared in corner mode). -->
            <local:NotchShape x:Name="CornerShape" Visibility="Collapsed" />
            <local:UnclampedGrid>
                <!-- Compact: icon only, like a hardware notch with a live activity. -->
                <Grid x:Name="CompactPanel" Height="30" Margin="11,0" Cursor="Hand" VerticalAlignment="Top"
                      Background="Transparent"
                      AutomationProperties.Name="Buka CodexBar">
                    <Border x:Name="CompactGlyph" Width="13" Height="13" CornerRadius="3.5" Background="White"
                            HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed">
                        <Border Width="7" Height="2.5" CornerRadius="0,0,1.5,1.5" Background="Black" VerticalAlignment="Top" />
                    </Border>
                    <!-- How many agents run at once (shown from two). -->
                    <TextBlock x:Name="CompactCount" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,21,0"
                               FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource NotchText2}" Visibility="Collapsed" />
                    <Grid x:Name="CompactIndicator" HorizontalAlignment="Right" VerticalAlignment="Center" Width="14" Height="14">
                        <Grid x:Name="SpinnerIndicator" Visibility="Collapsed">
                            <Ellipse Stroke="#2EFFFFFF" StrokeThickness="2.4" />
                            <Path Stroke="{StaticResource NotchAccent}" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M 7,1.2 A 5.8,5.8 0 0 1 12.8,7" RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <RotateTransform x:Name="SpinnerRotation" />
                                </Path.RenderTransform>
                            </Path>
                        </Grid>
                        <Grid x:Name="DoneIndicator" Visibility="Collapsed">
                            <Ellipse Fill="{StaticResource NotchGreen}" />
                            <Path Stroke="Black" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Data="M 4,7.3 L 6.1,9.4 L 10.2,4.9" />
                        </Grid>
                        <Ellipse x:Name="WaitIndicator" Width="8" Height="8" Fill="{StaticResource NotchOrange}" Visibility="Collapsed" />
                        <Grid x:Name="QuotaRing" Visibility="Collapsed">
                            <Ellipse Stroke="#33FFFFFF" StrokeThickness="2.2" />
                            <Path x:Name="QuotaArc" Stroke="#E6FFFFFF" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Grid>
                        <Ellipse x:Name="ErrorIndicator" Width="8" Height="8" Fill="{StaticResource NotchRed}" Visibility="Collapsed" />
                    </Grid>
                </Grid>

                <!-- Launcher: the notch drops down into a prompt + recent threads. -->
                <StackPanel x:Name="LauncherPanel" Margin="10" Width="540" HorizontalAlignment="Center" VerticalAlignment="Top"
                            Visibility="Collapsed" SizeChanged="Panel_SizeChanged">
                    <StackPanel.RenderTransform>
                        <TranslateTransform />
                    </StackPanel.RenderTransform>
                    <Border Height="50" CornerRadius="18" Background="{StaticResource NotchFill}" Padding="8,0,8,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <!-- Provider dropdown: the real logo, the name, a chevron. -->
                            <Button x:Name="ProviderButton" Style="{StaticResource NotchProviderButton}" Margin="0,0,12,0"
                                    Click="ProviderButton_Click" AutomationProperties.Name="Pilih provider">
                                <StackPanel Orientation="Horizontal">
                                    <Path x:Name="ProviderLogo" Width="16" Height="16" Stretch="Uniform" Fill="White" VerticalAlignment="Center" />
                                    <TextBlock x:Name="LauncherProviderText" Text="Codex" Margin="7,0,7,0" VerticalAlignment="Center" />
                                    <Path Stroke="#8CFFFFFF" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Data="M 1,1 L 4.5,4.5 L 8,1" VerticalAlignment="Center" Margin="0,1,0,0" />
                                </StackPanel>
                            </Button>
                            <Popup x:Name="ProviderPopup" PlacementTarget="{Binding ElementName=ProviderButton}" Placement="Bottom"
                                   VerticalOffset="8" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                                <Border Background="#FF1C1C1E" CornerRadius="14" Padding="6" MinWidth="230"
                                        BorderBrush="#33FFFFFF" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock x:Name="ProviderPopupHeader" FontSize="11" Foreground="{StaticResource NotchText3}" Margin="10,6,10,6" />
                                        <StackPanel x:Name="ProviderList" />
                                    </StackPanel>
                                </Border>
                            </Popup>
                            <TextBlock x:Name="LauncherPlaceholder" Grid.Column="1" Text="Tanya Codex, atau cari thread" FontSize="15"
                                       Foreground="{StaticResource NotchText3}" VerticalAlignment="Center" IsHitTestVisible="False" />
                            <TextBox x:Name="LauncherInput" Grid.Column="1" Style="{StaticResource NotchInput}" FontSize="15"
                                     TextChanged="LauncherInput_TextChanged" PreviewKeyDown="LauncherInput_PreviewKeyDown"
                                     AutomationProperties.Name="Tanya atau cari thread" />
                            <!-- Recording / transcribing state, drawn over the input. -->
                            <Grid x:Name="LauncherVoiceHost" Grid.Column="1" Visibility="Collapsed" Background="Transparent" />
                            <Button x:Name="MicButton" Grid.Column="2" Style="{StaticResource NotchIconButton}" Margin="0,0,2,0"
                                    PreviewMouseLeftButtonDown="MicButton_Down" PreviewMouseLeftButtonUp="MicButton_Up"
                                    AutomationProperties.Name="Input suara">
                                <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="14" Height="17" Stretch="None"
                                      Data="M 7,1.2 Q 9.6,1.2 9.6,3.8 L 9.6,8.2 Q 9.6,10.8 7,10.8 Q 4.4,10.8 4.4,8.2 L 4.4,3.8 Q 4.4,1.2 7,1.2 Z M 1.8,7.6 Q 1.8,13.2 7,13.2 Q 12.2,13.2 12.2,7.6 M 7,13.2 L 7,16" />
                            </Button>
                            <Button x:Name="ScreenshotButton" Grid.Column="3" Style="{StaticResource NotchIconButton}" Margin="0,0,6,0"
                                    Click="ScreenshotButton_Click" AutomationProperties.Name="Screenshot">
                                <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5"
                                      StrokeLineJoin="Round" Width="18" Height="16" Stretch="None"
                                      Data="M 1.5,4.5 L 1.5,13 Q 1.5,14.5 3,14.5 L 15,14.5 Q 16.5,14.5 16.5,13 L 16.5,4.5 Q 16.5,3 15,3 L 12.5,3 L 11.3,1.2 L 6.7,1.2 L 5.5,3 L 3,3 Q 1.5,3 1.5,4.5 Z M 12,8.6 A 3,3 0 1 1 6,8.6 A 3,3 0 1 1 12,8.6 Z" />
                            </Button>
                            <Button x:Name="LauncherSendButton" Grid.Column="4" Style="{StaticResource NotchRoundButton}" Width="34" Height="34"
                                    Click="LauncherSendButton_Click" IsEnabled="False" AutomationProperties.Name="Kirim">
                                <Path Stroke="Black" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Data="M 7,12 L 7,2 M 2.5,6.5 L 7,2 L 11.5,6.5" Width="14" Height="14" />
                            </Button>
                        </Grid>
                    </Border>

                    <Border x:Name="VoiceSetup" Margin="0,8,0,0" CornerRadius="14" Background="#12FFFFFF" Padding="14,12" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="VoiceSetupTitle" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock x:Name="VoiceSetupText" FontSize="12" Margin="0,3,0,0" Foreground="{StaticResource NotchText2}" TextWrapping="Wrap" />
                            <Grid Margin="0,10,0,0">
                                <Border x:Name="VoiceProgressTrack" Height="4" CornerRadius="2" Background="#1FFFFFFF" VerticalAlignment="Center"
                                        Visibility="Collapsed" Margin="0,0,12,0">
                                    <Border x:Name="VoiceProgressFill" HorizontalAlignment="Left" Width="0" CornerRadius="2" Background="White" />
                                </Border>
                                <StackPanel x:Name="VoiceSetupButtons" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button x:Name="VoiceLaterButton" Style="{StaticResource NotchPill}" Click="VoiceLater_Click" />
                                    <Button x:Name="VoiceDownloadButton" Style="{StaticResource NotchPrimaryPill}" Click="VoiceDownload_Click" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border x:Name="DropZone" Margin="0,8,0,0" Height="64" CornerRadius="14" Visibility="Collapsed"
                            Background="#0FFFFFFF" IsHitTestVisible="False">
                        <Grid>
                            <Rectangle RadiusX="14" RadiusY="14" Stroke="#59FFFFFF" StrokeThickness="1.2" StrokeDashArray="4 3" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Stroke="White" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Width="16" Height="16" Margin="0,0,9,0" VerticalAlignment="Center"
                                      Data="M 8,1.5 L 8,10.5 M 4,6.5 L 8,10.5 L 12,6.5 M 2,14.5 L 14,14.5" />
                                <TextBlock x:Name="DropZoneText" Text="Lepaskan untuk melampirkan" FontSize="13" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <WrapPanel x:Name="AttachmentTray" Margin="0,8,0,0" Visibility="Collapsed" />

                    <!-- Parallel agents (running or finished, until closed). -->
                    <StackPanel x:Name="AgentListPanel" Visibility="Collapsed">
                        <TextBlock x:Name="AgentHeader" Text="Agent paralel" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource NotchText3}" Margin="12,12,12,4" />
                        <StackPanel x:Name="AgentList" />
                    </StackPanel>

                    <TextBlock x:Name="RecentHeader" Text="Lanjutkan" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource NotchText3}" Margin="12,12,12,4" />
                    <ItemsControl x:Name="RecentList" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource NotchRowButton}" Click="RecentItem_Click" Tag="{Binding}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Width="6" Height="6" Fill="{Binding Dot}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding Meta}" FontSize="11" Margin="12,0,0,0"
                                                   Foreground="{StaticResource NotchText3}" VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <WrapPanel x:Name="ChipPanel" Margin="6,10,6,0" />

                    <!-- Subscription usage: one row per limit window. -->
                    <StackPanel x:Name="QuotaPanel" Margin="12,12,12,0" Visibility="Collapsed" />

                    <!-- Grabber: tap, or pull toward the screen edge, to fold the launcher back into the notch. -->
                    <Button x:Name="LauncherGrabber" Style="{StaticResource NotchGrabber}" Margin="0,10,0,0" HorizontalAlignment="Center"
                            Click="LauncherGrabber_Click" PreviewMouseLeftButtonDown="LauncherGrabber_Down"
                            PreviewMouseMove="LauncherGrabber_Move" AutomationProperties.Name="Tutup" />
                </StackPanel>

                <!-- Request: an approval or a question from the agent, answered right here. -->
                <StackPanel x:Name="RequestPanel" Margin="20,14,16,16" Width="564" HorizontalAlignment="Center" VerticalAlignment="Top"
                            Visibility="Collapsed" SizeChanged="Panel_SizeChanged">
                    <Grid Height="22">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource NotchOrange}" Margin="0,0,9,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="RequestKind" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock x:Name="RequestContext" FontSize="12" Foreground="{StaticResource NotchText3}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock x:Name="RequestTitle" Margin="0,10,0,0" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="RequestMessage" Margin="0,4,0,0" FontSize="13" Foreground="#9BFFFFFF" TextWrapping="Wrap" />
                    <Border x:Name="RequestDetailBox" Margin="0,12,0,0" Background="#12FFFFFF" CornerRadius="12" Padding="12,10">
                        <ScrollViewer MaxHeight="170" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <TextBlock x:Name="RequestDetail" FontFamily="Cascadia Mono, Consolas" FontSize="12" LineHeight="19"
                                       Foreground="#E6FFFFFF" TextWrapping="Wrap" />
                        </ScrollViewer>
                    </Border>
                    <StackPanel x:Name="RequestFields" Margin="0,12,0,0" />
                    <TextBlock x:Name="RequestError" Margin="0,8,0,0" FontSize="12" Foreground="#FF6B61" TextWrapping="Wrap" Visibility="Collapsed" />
                    <Grid Margin="0,16,0,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="RequestLink" Style="{StaticResource NotchTextLink}" Click="RequestLink_Click" />
                            <TextBlock x:Name="RequestCountdown" Margin="12,0,0,0" FontSize="12" Foreground="{StaticResource NotchText3}" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="RequestTertiary" Style="{StaticResource NotchPill}" Click="RequestTertiary_Click" />
                            <Button x:Name="RequestSecondary" Style="{StaticResource NotchPill}" Click="RequestSecondary_Click" />
                            <Button x:Name="RequestPrimary" Style="{StaticResource NotchPrimaryPill}" Click="RequestPrimary_Click" />
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <!-- Activity: steps + live output of the running (or last) turn. -->
                <StackPanel x:Name="ActivityPanel" Margin="20,12,16,16" Width="564" HorizontalAlignment="Center" VerticalAlignment="Top"
                            Visibility="Collapsed" SizeChanged="Panel_SizeChanged">
                    <StackPanel.RenderTransform>
                        <TranslateTransform />
                    </StackPanel.RenderTransform>
                    <Grid Height="30">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                            <Run x:Name="ActivityProviderRun" Text="Codex" FontSize="12" FontWeight="SemiBold" />
                            <Run x:Name="ActivityContextRun" Text="  CodexBar" FontSize="12" Foreground="{StaticResource NotchText3}" />
                        </TextBlock>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <StackPanel x:Name="ActivityPager" Orientation="Horizontal" Margin="0,0,6,0" Visibility="Collapsed">
                                <Button Style="{StaticResource NotchIconButton}" Width="24" Click="PrevActivity_Click" AutomationProperties.Name="Agent sebelumnya">
                                    <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M 6,1 L 2,5 L 6,9" />
                                </Button>
                                <TextBlock x:Name="ActivityPagerText" FontSize="11" Foreground="{StaticResource NotchText3}"
                                           VerticalAlignment="Center" Margin="2,0" FontFamily="Segoe UI Variable Text, Segoe UI" />
                                <Button Style="{StaticResource NotchIconButton}" Width="24" Click="NextActivity_Click" AutomationProperties.Name="Agent berikutnya">
                                    <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M 2,1 L 6,5 L 2,9" />
                                </Button>
                            </StackPanel>
                            <Button x:Name="PinButton" Style="{StaticResource NotchIconButton}" Click="PinButton_Click" ToolTip="Sematkan" AutomationProperties.Name="Sematkan">
                                <Path x:Name="PinGlyph" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Data="M 5,1.5 L 10,1.5 L 9.2,6.5 L 11.5,9 L 3.5,9 L 5.8,6.5 Z M 7.5,9 L 7.5,14" Width="15" Height="15" />
                            </Button>
                            <Button Style="{StaticResource NotchIconButton}" Click="OpenWindowButton_Click" ToolTip="Buka di jendela" AutomationProperties.Name="Buka di jendela">
                                <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Data="M 9,2 L 13,2 L 13,6 M 13,2 L 8,7 M 6,3 L 3,3 L 3,13 L 13,13 L 13,10" Width="15" Height="15" />
                            </Button>
                            <Button Style="{StaticResource NotchIconButton}" Click="CloseButton_Click" ToolTip="Tutup" AutomationProperties.Name="Tutup">
                                <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Data="M 3.5,3.5 L 11.5,11.5 M 11.5,3.5 L 3.5,11.5" Width="15" Height="15" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <TextBlock x:Name="ActivityPrompt" Margin="0,8,0,0" FontSize="13" Foreground="#9BFFFFFF"
                               TextWrapping="Wrap" MaxHeight="40" TextTrimming="CharacterEllipsis" />

                    <ItemsControl x:Name="StepList" Margin="0,10,0,0" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="14" Height="14" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <Path Visibility="{Binding DoneVisibility}" Stroke="#30D158" StrokeThickness="2"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              Data="M 2.5,7.5 L 5.6,10.4 L 11.5,3.8" />
                                        <Ellipse Visibility="{Binding ActiveVisibility}" Width="7" Height="7" Fill="#0A84FF" />
                                    </Grid>
                                    <TextBlock Grid.Column="1" Text="{Binding Text}" Foreground="{Binding Brush}" FontSize="13"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border x:Name="OutputBox" Margin="0,4,0,0" Background="#12FFFFFF" CornerRadius="12" Padding="12,9" Visibility="Collapsed">
                        <TextBlock x:Name="OutputText" FontFamily="Cascadia Mono, Consolas" FontSize="12" LineHeight="19"
                                   Foreground="#B3FFFFFF" TextWrapping="Wrap" MaxHeight="134" />
                    </Border>

                    <!-- Files the agent changed this turn: summary row, expands into a list with diffs. -->
                    <Border x:Name="FilesBox" Margin="0,8,0,0" Background="#12FFFFFF" CornerRadius="12" Visibility="Collapsed">
                        <StackPanel>
                            <Grid Height="38">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="FilesHeaderButton" Style="{StaticResource NotchRowButton}" Height="38" Click="FilesHeader_Click"
                                        AutomationProperties.Name="File yang diubah">
                                    <StackPanel Orientation="Horizontal">
                                        <Path x:Name="FilesChevron" Stroke="{StaticResource NotchText3}" StrokeThickness="1.6" Width="10" Height="10"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              Data="M 3,1.5 L 7,5 L 3,8.5" RenderTransformOrigin="0.5,0.5" Margin="0,0,10,0" VerticalAlignment="Center">
                                            <Path.RenderTransform>
                                                <RotateTransform x:Name="FilesChevronRotation" />
                                            </Path.RenderTransform>
                                        </Path>
                                        <TextBlock x:Name="FilesSummary" FontSize="13" VerticalAlignment="Center" />
                                        <TextBlock x:Name="FilesAdded" FontSize="12" Margin="10,0,0,0" Foreground="{StaticResource NotchGreen}"
                                                   FontFamily="Cascadia Mono, Consolas" VerticalAlignment="Center" />
                                        <TextBlock x:Name="FilesRemoved" FontSize="12" Margin="6,0,0,0" Foreground="{StaticResource NotchRed}"
                                                   FontFamily="Cascadia Mono, Consolas" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="OpenEditorButton" Grid.Column="1" Style="{StaticResource NotchTextLink}" Margin="8,0,14,0"
                                        Click="OpenEditor_Click" Content="Buka di VS Code" />
                            </Grid>
                            <ScrollViewer x:Name="FilesScroller" MaxHeight="232" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed" Focusable="False">
                                <StackPanel x:Name="FilesList" Margin="4,0,4,6" />
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                    <!-- Prompts waiting for the current turn to finish. -->
                    <StackPanel x:Name="QueueBox" Margin="0,10,0,0" Visibility="Collapsed">
                        <Grid Height="22" Margin="2,0,0,2">
                            <TextBlock VerticalAlignment="Center">
                                <Run x:Name="QueueTitleRun" Text="Antrean" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource NotchText3}" />
                                <Run x:Name="QueueStateRun" FontSize="11" Foreground="{StaticResource NotchOrange}" />
                            </TextBlock>
                            <Button x:Name="QueueSendNowButton" Style="{StaticResource NotchTextLink}" HorizontalAlignment="Right"
                                    Click="QueueSendNow_Click" Content="Kirim sekarang" Visibility="Collapsed" />
                        </Grid>
                        <StackPanel x:Name="QueueList" />
                    </StackPanel>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Height="38" CornerRadius="19" Background="#17FFFFFF" Padding="16,0">
                            <Grid>
                                <TextBlock x:Name="FollowUpPlaceholder" Text="Tambahkan instruksi…" Foreground="{StaticResource NotchText3}"
                                           VerticalAlignment="Center" IsHitTestVisible="False" />
                                <TextBox x:Name="FollowUpInput" Style="{StaticResource NotchInput}"
                                         TextChanged="FollowUpInput_TextChanged" PreviewKeyDown="FollowUpInput_PreviewKeyDown"
                                         AutomationProperties.Name="Tambahkan instruksi" />
                                <Grid x:Name="FollowUpVoiceHost" Visibility="Collapsed" Background="Transparent" />
                            </Grid>
                        </Border>
                        <Button x:Name="ActionButton" Grid.Column="1" Width="38" Height="38" Margin="8,0,0,0"
                                Style="{StaticResource NotchRoundButton}" Click="ActionButton_Click" AutomationProperties.Name="Hentikan">
                            <Grid>
                                <Border x:Name="StopGlyph" Width="12" Height="12" CornerRadius="3" Background="Black" />
                                <Path x:Name="SendGlyph" Visibility="Collapsed" Stroke="Black" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Data="M 7,12 L 7,2 M 2.5,6.5 L 7,2 L 11.5,6.5" Width="14" Height="14" />
                            </Grid>
                        </Button>
                    </Grid>
                </StackPanel>
            </local:UnclampedGrid>
            </Grid>
        </Border>
    </Grid>
    </Grid>
</Window>
