<Window x:Class="CodexBar.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CodexBar.App"
        Title="CodexBar"
        Icon="codexbar.ico"
        Width="640"
        MinWidth="500"
        MaxWidth="1200"
        MaxHeight="900"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Transparent"
        AllowsTransparency="True"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewMouseWheel="Window_PreviewMouseWheel"
        Activated="Window_Activated"
        Deactivated="Window_Deactivated"
        Closing="Window_Closing"
        SourceInitialized="Window_SourceInitialized"
        Loaded="Window_Loaded"
        LocationChanged="Window_LocationChanged"
        SizeChanged="Window_SizeChanged">

    <Window.Resources>
        <SolidColorBrush x:Key="SettingsLabelBrush" Color="#4A5464" />
        <SolidColorBrush x:Key="SettingsValueBrush" Color="#1B2230" />
        <Style x:Key="SettingLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SettingsLabelBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,3" />
        </Style>
        <Style x:Key="SettingValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SettingsValueBrush}" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder"
            CornerRadius="18"
            BorderThickness="1"
            BorderBrush="#2EFFFFFF"
            Background="Transparent"
            SnapsToDevicePixels="True"
            MouseLeftButtonDown="RootBorder_MouseLeftButtonDown">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Launcher satu baris: menu · direktori · field(input + kirim) · settings -->
            <Grid x:Name="InputBarArea" Grid.Row="0" Margin="11,10,12,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Status disimpan untuk konteks/output; ditampilkan via warna StatusDot + tooltip. -->
                <TextBlock x:Name="StatusText" Visibility="Collapsed" Text="Menyiapkan Codex…" />

                <!-- Grip drag handle -->
                <Path x:Name="DragGrip" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0"
                      Fill="{DynamicResource IconBrush}" Opacity="0.45" IsHitTestVisible="False">
                    <Path.Data>
                        <GeometryGroup>
                            <EllipseGeometry Center="0,0" RadiusX="1.15" RadiusY="1.15" />
                            <EllipseGeometry Center="0,5" RadiusX="1.15" RadiusY="1.15" />
                            <EllipseGeometry Center="0,10" RadiusX="1.15" RadiusY="1.15" />
                            <EllipseGeometry Center="4,0" RadiusX="1.15" RadiusY="1.15" />
                            <EllipseGeometry Center="4,5" RadiusX="1.15" RadiusY="1.15" />
                            <EllipseGeometry Center="4,10" RadiusX="1.15" RadiusY="1.15" />
                        </GeometryGroup>
                    </Path.Data>
                </Path>

                <Button x:Name="MenuButton" Grid.Column="1" Content="&#xE700;" Click="MenuButton_Click"
                        FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15"
                        VerticalAlignment="Center" Width="34" Height="34" Margin="0,0,6,0"
                        Style="{StaticResource GlassIconButton}" ToolTip="Menu &amp; riwayat Codex"
                        AutomationProperties.Name="Menu dan riwayat Codex" />

                <!-- Chip direktori -->
                <Button x:Name="WorkspaceButton" Grid.Column="2" Click="WorkspaceButton_Click"
                        Style="{StaticResource GlassPillButton}" Height="34" Padding="11,0"
                        VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="Pilih workspace"
                        MouseEnter="WorkspaceButton_MouseEnter" MouseLeave="WorkspaceButton_MouseLeave"
                        AutomationProperties.Name="Pilih workspace">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#5EE6A8"
                                 VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE8B7;"
                                   FontSize="13.5" VerticalAlignment="Center" Margin="0,0,7,0"
                                   Foreground="{DynamicResource IconBrush}" />
                        <TextBlock x:Name="WorkspacePathText" Text="workspace" FontSize="12.5"
                                   VerticalAlignment="Center" FontWeight="Medium"
                                   TextTrimming="CharacterEllipsis" MaxWidth="150" RenderTransformOrigin="0,0.5" />
                    </StackPanel>
                </Button>

                <!-- Field input: kotak ketik + tombol kirim kecil di dalam -->
                <Border x:Name="PromptField" Grid.Column="3" CornerRadius="16"
                        BorderThickness="1" Background="#14000000" BorderBrush="#22000000"
                        MouseEnter="PromptField_MouseEnter" MouseLeave="PromptField_MouseLeave">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border x:Name="AttachmentBar" Grid.Row="0" Grid.ColumnSpan="3"
                                Visibility="Collapsed" Margin="8,7,8,0" Padding="4,2"
                                CornerRadius="8" Background="{DynamicResource GlassTrack}">
                            <WrapPanel x:Name="AttachmentPanel" />
                        </Border>

                        <Grid Grid.Row="1" Grid.Column="0">
                            <TextBox x:Name="PromptBox"
                                     MinHeight="44" MaxHeight="150"
                                     Padding="15,11,8,11"
                                     FontSize="14.5"
                                     VerticalContentAlignment="Center"
                                     AcceptsReturn="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     Background="Transparent" BorderThickness="0"
                                     Foreground="#F2F3F5" CaretBrush="#79A9FF"
                                     GotFocus="PromptBox_GotFocus" LostFocus="PromptBox_LostFocus"
                                     TextChanged="PromptBox_TextChanged"
                                     PreviewKeyDown="PromptBox_PreviewKeyDown"
                                     AutomationProperties.Name="Prompt untuk Codex" />
                            <TextBlock x:Name="PromptPlaceholder" Text="Tanya Codex apa saja…  •  Ctrl+V screenshot"
                                       IsHitTestVisible="False" FontSize="14.5"
                                       Foreground="{DynamicResource TextMuted}"
                                       VerticalAlignment="Center" Margin="16,0,0,0" />
                        </Grid>

                        <Button x:Name="AttachButton" Grid.Row="1" Grid.Column="1"
                                Content="&#xE723;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                Width="30" Height="30" Margin="0,0,2,0" VerticalAlignment="Center"
                                ToolTip="Tambahkan gambar atau file" Style="{StaticResource GlassIconButton}"
                                Click="AttachButton_Click" AutomationProperties.Name="Tambahkan lampiran" />

                        <Button x:Name="SendButton" Grid.Row="1" Grid.Column="2"
                                Width="30" Height="30" Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                ToolTip="Kirim (Enter)"
                                Style="{StaticResource AccentButton}"
                                Click="SendButton_Click"
                                AutomationProperties.Name="Kirim prompt">
                            <Path Width="14" Height="12" Stretch="Uniform"
                                  Stroke="White" StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Data="M14,4.5 V10 H5.5 M8.5,7 L5.5,10 L8.5,13" />
                        </Button>
                        <Button x:Name="StopButton" Grid.Row="1" Grid.Column="2"
                                Width="30" Height="30" Margin="0,0,6,0"
                                VerticalAlignment="Center" Visibility="Collapsed"
                                ToolTip="Hentikan pekerjaan (Ctrl+.)"
                                Style="{StaticResource GlassIconButton}"
                                Click="StopButton_Click"
                                AutomationProperties.Name="Hentikan pekerjaan">
                            <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2"
                                       Fill="{DynamicResource IconBrush}" />
                        </Button>
                    </Grid>
                </Border>

                <Button x:Name="ContextUsageButton" Grid.Column="4" Content="Ctx —"
                        Visibility="Collapsed" Height="30" Padding="9,0" Margin="7,0,0,0"
                        VerticalAlignment="Center" Style="{StaticResource GlassPillButton}"
                        ToolTip="Pemakaian context thread; klik untuk compact"
                        Click="CompactButton_Click" AutomationProperties.Name="Pemakaian context" />
                <Button x:Name="ConversationButton" Grid.Column="5" Content="&#xE8BD;" Click="ConversationButton_Click"
                        FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15"
                        VerticalAlignment="Center" Width="34" Height="34" Margin="8,0,0,0"
                        Style="{StaticResource GlassIconButton}" ToolTip="Tampilkan/sembunyikan percakapan"
                        AutomationProperties.Name="Tampilkan atau sembunyikan percakapan" />
                <Button x:Name="SettingsButton" Grid.Column="6" Content="&#xE713;" Click="SettingsButton_Click"
                        FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15"
                        VerticalAlignment="Center" Width="34" Height="34" Margin="8,0,0,0"
                        Style="{StaticResource GlassIconButton}" ToolTip="Settings"
                        AutomationProperties.Name="Pengaturan" />
            </Grid>

            <!-- Output inline (mode docked) -->
            <Grid x:Name="InlineResponseArea" Grid.Row="1" Margin="14,2,12,12" Visibility="Collapsed">
                <local:ConversationView x:Name="InlineConversation" />
                <Button x:Name="JumpLatestButton" Content="↓ Terbaru" Visibility="Collapsed"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,10,8"
                        Style="{StaticResource GlassPillButton}" Click="JumpLatestButton_Click" />
            </Grid>

            <!-- Onboarding (Codex belum terpasang / belum login) -->
            <Border x:Name="OnboardingPanel" Grid.Row="1" Visibility="Collapsed"
                    Margin="14,2,14,12" CornerRadius="12" Padding="16,14"
                    Background="#16000000" BorderBrush="#22000000" BorderThickness="1">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Ellipse Width="9" Height="9" Fill="#E6B45E" VerticalAlignment="Center" Margin="0,0,9,0" />
                        <TextBlock x:Name="OnboardingTitle" Text="Hampir siap" FontWeight="SemiBold" FontSize="14"
                                   VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}" />
                    </StackPanel>
                    <TextBlock x:Name="OnboardingBody" TextWrapping="Wrap" FontSize="12.5"
                               Foreground="{DynamicResource TextMuted}" Margin="0,0,0,10"
                               Text="CodexBar memerlukan Codex CLI yang sudah login." />

                    <Border x:Name="OnboardingCommandBox" CornerRadius="9" Padding="12,9" Margin="0,0,0,12"
                            Background="#1E000000" BorderBrush="#26000000" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="OnboardingCommand" Grid.Column="0" VerticalAlignment="Center"
                                       FontFamily="Cascadia Mono, Consolas" FontSize="12.5"
                                       Foreground="{DynamicResource TextPrimary}"
                                       Text="npm install -g @openai/codex" TextTrimming="CharacterEllipsis" />
                            <Button x:Name="OnboardingCopyButton" Grid.Column="1" Content="Salin"
                                    Style="{StaticResource GlassPillButton}" Height="28" Click="OnboardingCopyButton_Click" />
                        </Grid>
                    </Border>

                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="OnboardingActionButton" Content="Pasang otomatis"
                                Style="{StaticResource AccentButton}" Height="32" Padding="16,0"
                                Margin="0,0,8,0" Visibility="Collapsed"
                                Click="OnboardingActionButton_Click" />
                        <Button x:Name="OnboardingRetryButton" Content="Coba lagi" Style="{StaticResource AccentButton}"
                                Height="32" Padding="16,0" Margin="0,0,8,0" Click="OnboardingRetryButton_Click" />
                        <Button x:Name="OnboardingDocsButton" Content="Buka panduan" Style="{StaticResource GlassPillButton}"
                                Click="OnboardingDocsButton_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Settings panel -->
            <Border x:Name="SettingsPanel" Grid.Row="2" Visibility="Collapsed"
                    Background="#0CFFFFFF" BorderBrush="#3DFFFFFF" BorderThickness="0,1,0,0"
                    Padding="18,12,18,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="58" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.ColumnSpan="3" Text="Tampilan" FontWeight="SemiBold" Foreground="{DynamicResource SettingsValueBrush}" Margin="0,0,0,8" />

                    <TextBlock Grid.Row="1" Text="Lebar" Style="{StaticResource SettingLabelStyle}" />
                    <Slider x:Name="WidthSlider" Grid.Row="1" Grid.Column="1" Minimum="500" Maximum="1200" ValueChanged="SettingsControl_Changed" />
                    <TextBlock x:Name="WidthValue" Grid.Row="1" Grid.Column="2" Style="{StaticResource SettingValueStyle}" />

                    <TextBlock Grid.Row="2" Text="Tinggi output" Style="{StaticResource SettingLabelStyle}" />
                    <Slider x:Name="HeightSlider" Grid.Row="2" Grid.Column="1" Minimum="180" Maximum="900" ValueChanged="SettingsControl_Changed" />
                    <TextBlock x:Name="HeightValue" Grid.Row="2" Grid.Column="2" Style="{StaticResource SettingValueStyle}" />

                    <TextBlock Grid.Row="3" Text="Opacity aktif" Style="{StaticResource SettingLabelStyle}" Visibility="Collapsed" />
                    <Slider x:Name="ActiveOpacitySlider" Grid.Row="3" Grid.Column="1" Minimum="0.4" Maximum="1" ValueChanged="SettingsControl_Changed" Visibility="Collapsed" />
                    <TextBlock x:Name="ActiveOpacityValue" Grid.Row="3" Grid.Column="2" Style="{StaticResource SettingValueStyle}" Visibility="Collapsed" />

                    <TextBlock Grid.Row="4" Text="Opacity idle" Style="{StaticResource SettingLabelStyle}" Visibility="Collapsed" />
                    <Slider x:Name="InactiveOpacitySlider" Grid.Row="4" Grid.Column="1" Minimum="0.25" Maximum="1" ValueChanged="SettingsControl_Changed" Visibility="Collapsed" />
                    <TextBlock x:Name="InactiveOpacityValue" Grid.Row="4" Grid.Column="2" Style="{StaticResource SettingValueStyle}" Visibility="Collapsed" />

                    <TextBlock Grid.Row="5" Text="Font input" Style="{StaticResource SettingLabelStyle}" />
                    <Slider x:Name="InputFontSlider" Grid.Row="5" Grid.Column="1" Minimum="10" Maximum="24" ValueChanged="SettingsControl_Changed" />
                    <TextBlock x:Name="InputFontValue" Grid.Row="5" Grid.Column="2" Style="{StaticResource SettingValueStyle}" />

                    <TextBlock Grid.Row="6" Text="Font respons" Style="{StaticResource SettingLabelStyle}" />
                    <Slider x:Name="ResponseFontSlider" Grid.Row="6" Grid.Column="1" Minimum="10" Maximum="24" ValueChanged="SettingsControl_Changed" />
                    <TextBlock x:Name="ResponseFontValue" Grid.Row="6" Grid.Column="2" Style="{StaticResource SettingValueStyle}" />

                    <TextBlock Grid.Row="7" Text="Hotkey" Style="{StaticResource SettingLabelStyle}" VerticalAlignment="Top" Margin="0,7,0,0" />
                    <Grid Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBox x:Name="HotkeyTextBox" Grid.Row="0" Grid.Column="0"
                                 IsReadOnly="True" Height="30" Padding="9,4" Margin="0,0,8,0"
                                 VerticalContentAlignment="Center" FontFamily="Cascadia Mono, Consolas"
                                 Background="{DynamicResource GlassTrack}" Foreground="{DynamicResource TextPrimary}"
                                 BorderBrush="{DynamicResource GlassStroke}" BorderThickness="1"
                                 ToolTip="Klik lalu tekan kombinasi baru, misalnya Ctrl+Alt+C"
                                 AutomationProperties.Name="Kombinasi hotkey global"
                                 PreviewKeyDown="HotkeyTextBox_PreviewKeyDown" />
                        <Button x:Name="ApplyHotkeyButton" Grid.Row="0" Grid.Column="1"
                                Content="Terapkan" Style="{StaticResource GlassPillButton}"
                                IsEnabled="False" Click="ApplyHotkeyButton_Click" />
                        <TextBlock x:Name="HotkeyStatusText" Grid.Row="1" Grid.ColumnSpan="2"
                                   Margin="2,4,0,0" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextMuted}"
                                   Text="Klik field lalu tekan kombinasi dengan Win, Ctrl, Alt, atau Shift." />
                    </Grid>

                    <TextBlock Grid.Row="8" Text="Permission" Style="{StaticResource SettingLabelStyle}" VerticalAlignment="Top" Margin="0,7,0,0" />
                    <Grid Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4,0,4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ComboBox x:Name="SandboxCombo" Grid.Row="0" Width="210" HorizontalAlignment="Left"
                                  FontFamily="Cascadia Mono, Consolas"
                                  SelectionChanged="SandboxCombo_SelectionChanged"
                                  AutomationProperties.Name="Permission workspace">
                            <ComboBoxItem Content="read-only" Tag="read-only" />
                            <ComboBoxItem Content="workspace-write" Tag="workspace-write" />
                            <ComboBoxItem Content="danger-full-access" Tag="danger-full-access" />
                        </ComboBox>
                        <TextBlock x:Name="SandboxStatusText" Grid.Row="1" Margin="2,4,0,0"
                                   FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}"
                                   Text="workspace-write: dapat mengubah file di workspace; akses lain tetap meminta approval." />
                    </Grid>

                    <WrapPanel Grid.Row="9" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,8,0,0">
                        <StackPanel x:Name="ModelRow" Orientation="Horizontal" Margin="0,3,14,3" VerticalAlignment="Center" Visibility="Collapsed">
                            <TextBlock Text="Model" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource SettingsLabelBrush}" />
                            <ComboBox x:Name="ModelCombo" Width="152" DisplayMemberPath="DisplayName"
                                      SelectionChanged="ModelCombo_SelectionChanged"
                                      ToolTip="Pilih model GPT untuk percakapan ini" />
                        </StackPanel>
                        <ComboBox x:Name="ThemeCombo" Width="100" Margin="0,3,10,3" SelectionChanged="SettingsControl_Changed">
                            <ComboBoxItem Content="System" Tag="system" />
                            <ComboBoxItem Content="Light" Tag="light" />
                            <ComboBoxItem Content="Dark" Tag="dark" />
                        </ComboBox>
                        <StackPanel Orientation="Horizontal" Margin="0,3,12,3" VerticalAlignment="Center">
                            <TextBlock Text="Output" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource SettingsLabelBrush}" />
                            <ComboBox x:Name="OutputPositionCombo" Width="130" SelectionChanged="SettingsControl_Changed"
                                      ToolTip="Posisi panel percakapan saat menyatu" AutomationProperties.Name="Posisi output">
                                <ComboBoxItem Content="Di bawah input" Tag="below" />
                                <ComboBoxItem Content="Di atas input" Tag="above" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3,12,3" VerticalAlignment="Center">
                            <TextBlock Text="Approval" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource SettingsLabelBrush}" />
                            <ComboBox x:Name="ApprovalCombo" Width="130" FontFamily="Cascadia Mono, Consolas"
                                      SelectionChanged="SettingsControl_Changed"
                                      ToolTip="Kebijakan approval Codex (sama seperti --ask-for-approval)"
                                      AutomationProperties.Name="Kebijakan approval">
                                <ComboBoxItem Content="untrusted" Tag="untrusted" />
                                <ComboBoxItem Content="on-failure" Tag="on-failure" />
                                <ComboBoxItem Content="on-request" Tag="on-request" />
                                <ComboBoxItem Content="never" Tag="never" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3,12,3" VerticalAlignment="Center">
                            <TextBlock Text="Effort" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource SettingsLabelBrush}" />
                            <ComboBox x:Name="EffortCombo" Width="110"
                                      SelectionChanged="SettingsControl_Changed"
                                      ToolTip="Reasoning effort untuk turn berikutnya"
                                      AutomationProperties.Name="Reasoning effort">
                                <ComboBoxItem Content="default" Tag="" />
                                <ComboBoxItem Content="minimal" Tag="minimal" />
                                <ComboBoxItem Content="low" Tag="low" />
                                <ComboBoxItem Content="medium" Tag="medium" />
                                <ComboBoxItem Content="high" Tag="high" />
                            </ComboBox>
                        </StackPanel>
                        <CheckBox x:Name="OutputDockedCheck" Content="Output menyatu" Margin="0,3,12,3" Checked="SettingsControl_Changed" Unchecked="SettingsControl_Changed" />
                        <CheckBox x:Name="MenuDockedCheck" Content="Menu menyatu" Margin="0,3,12,3" Checked="SettingsControl_Changed" Unchecked="SettingsControl_Changed" />
                        <ToggleButton x:Name="TopmostToggle" Content="Selalu di atas" Margin="0,3,12,3" Style="{StaticResource GlassToggle}" Click="TopmostToggle_Click" />
                        <CheckBox x:Name="WordWrapCheckBox" Content="Wrap kode" Margin="0,3,12,3" Checked="SettingsControl_Changed" Unchecked="SettingsControl_Changed" />
                        <CheckBox x:Name="ShowReasoningCheck" Content="Tampilkan thinking" Margin="0,3,12,3" Checked="SettingsControl_Changed" Unchecked="SettingsControl_Changed" />
                        <CheckBox x:Name="PinCheckBox" Content="Pin" Margin="0,3,12,3" Checked="SettingsControl_Changed" Unchecked="SettingsControl_Changed" />
                    </WrapPanel>

                    <WrapPanel Grid.Row="10" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button x:Name="OutputButton" Content="Tampilkan output" Style="{StaticResource GlassPillButton}" Margin="0,0,8,6" Visibility="Collapsed" Click="OutputButton_Click" />
                        <Button x:Name="CompactButton" Content="Padatkan konteks" Style="{StaticResource GlassPillButton}" Margin="0,0,8,6" Click="CompactButton_Click"
                                ToolTip="Ringkas riwayat agar konteks tidak penuh (thread/compact)" />
                        <Button Content="Salin percakapan" Style="{StaticResource GlassPillButton}" Margin="0,0,8,6" Click="CopyResponseButton_Click" />
                        <Button Content="Export checkpoint" Style="{StaticResource GlassPillButton}" Margin="0,0,8,6" Click="ExportCheckpointButton_Click"
                                ToolTip="Simpan percakapan aktif sebagai Markdown lokal" />
                        <Button Content="Reset layout" Style="{StaticResource GlassPillButton}" Margin="0,0,8,6" Click="ResetLayoutButton_Click" />
                        <Button Content="Tutup" Style="{StaticResource GlassPillButton}" Margin="0,0,8,6" Click="CloseSettingsButton_Click" />
                        <TextBlock x:Name="TokenUsageText" VerticalAlignment="Center" Margin="4,0,0,6"
                                   FontSize="11.5" Foreground="{DynamicResource SettingsLabelBrush}"
                                   Text="Token: —" />
                    </WrapPanel>

                    <TextBlock x:Name="AboutText" Grid.Row="11" Grid.ColumnSpan="3" Margin="0,12,0,0"
                               FontSize="11.5" TextWrapping="Wrap"
                               Foreground="{DynamicResource SettingsLabelBrush}"
                               Text="Aplikasi komunitas tidak resmi. Prompt dan konteks workspace diproses melalui Codex CLI serta layanan OpenAI sesuai akun dan kebijakan Anda. Settings disimpan lokal." />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
