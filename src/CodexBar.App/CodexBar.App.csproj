<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\CodexBar.Core\CodexBar.Core.csproj" />
    <ProjectReference Include="..\CodexBar.Providers\CodexBar.Providers.csproj" />
    <ProjectReference Include="..\CodexBar.Providers.Codex\CodexBar.Providers.Codex.csproj" />
    <ProjectReference Include="..\CodexBar.Providers.ClaudeCode\CodexBar.Providers.ClaudeCode.csproj" />
    <ProjectReference Include="..\CodexBar.Providers.Anthropic\CodexBar.Providers.Anthropic.csproj" />
    <ProjectReference Include="..\CodexBar.Providers.OpenAI\CodexBar.Providers.OpenAI.csproj" />
    <ProjectReference Include="..\CodexBar.Providers.OpenRouter\CodexBar.Providers.OpenRouter.csproj" />
    <ProjectReference Include="..\CodexBar.Windows\CodexBar.Windows.csproj" />
    <ProjectReference Include="..\CodexBar.Persistence\CodexBar.Persistence.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ApplicationIcon>codexbar.ico</ApplicationIcon>
    <AssemblyName>CodexBar.App</AssemblyName>
    <Product>CodexBar</Product>
    <Company>CodexBar</Company>
    <Authors>CodexBar</Authors>
    <Description>Companion ringan untuk mengirim prompt ke Codex lewat hotkey.</Description>
    <Version>1.3.0</Version>
    <FileVersion>1.3.0.0</FileVersion>
    <AssemblyVersion>1.3.0.0</AssemblyVersion>
    <Copyright>© 2026 CodexBar</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="codexbar.ico" />
    <Resource Include="Fonts\Sora-SemiBold.ttf" />
    <Content Include="Fonts\OFL.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
