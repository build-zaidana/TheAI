<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Dimension tokens of the glass panel language (canvas board 16). Every size is derived, none eyeballed. -->
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="S1">12</sys:Double>   <!-- panel edge to pane edge -->
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="S2">16</sys:Double>   <!-- pane edge to content -->
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="S3">10</sys:Double>   <!-- gap between panes -->
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="S4">12</sys:Double>   <!-- inline gap, icon to text -->
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="R1">48</sys:Double>   <!-- panel radius -->
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="R2">36</sys:Double>   <!-- pane radius = R1 - S1 -->
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="R3">20</sys:Double>   <!-- control in a pane = R2 - S2 -->
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="RowHeight">48</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="HeaderHeight">44</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="RowIcon">32</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="Tile">48</sys:Double>  <!-- 2 * (R2 - S1) -->

    <CornerRadius x:Key="PanelRadius">48</CornerRadius>
    <CornerRadius x:Key="PaneRadius">36</CornerRadius>
    <CornerRadius x:Key="ControlRadius">20</CornerRadius>
    <Thickness x:Key="PanelPadding">12</Thickness>
    <Thickness x:Key="PanePadding">16</Thickness>
    <Thickness x:Key="ListPanePadding">16,8</Thickness>   <!-- 16 - (48 - 32) / 2 vertically -->

    <!-- Glass pane (boards 3 and 12): a faint fill and a 1 px rim, bright at the top, dim at the sides,
         a little light again at the bottom. Flat, no blur, no glow. -->
    <LinearGradientBrush x:Key="GlassRim" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#7AFFFFFF" Offset="0" />
        <GradientStop Color="#26FFFFFF" Offset="0.33" />
        <GradientStop Color="#0FFFFFFF" Offset="0.69" />
        <GradientStop Color="#2EFFFFFF" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="GlassFill" Color="#16FFFFFF" />
    <Style x:Key="GlassPane" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource GlassFill}" />
        <Setter Property="BorderBrush" Value="{StaticResource GlassRim}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource PaneRadius}" />
    </Style>
</ResourceDictionary>
