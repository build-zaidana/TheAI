<Window x:Class="CodexBar.App.ConversationPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CodexBar.App"
        Title="CodexBar"
        AutomationProperties.Name="Percakapan CodexBar"
        Width="436"
        Height="800"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Grayscale"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="14"
        Foreground="White"
        KeyboardNavigation.TabNavigation="Cycle"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing">

    <Window.Resources>
        <SolidColorBrush x:Key="PanelText" Color="#F5F5F7" />
        <SolidColorBrush x:Key="PanelText2" Color="#A6FFFFFF" />
        <SolidColorBrush x:Key="PanelText3" Color="#66FFFFFF" />
        <SolidColorBrush x:Key="PanelControl" Color="#17FFFFFF" />
        <SolidColorBrush x:Key="PanelControlHover" Color="#29FFFFFF" />

        <Style x:Key="PanelRoundButton" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="14" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource PanelControl}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PanelSendButton" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="7" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource PanelControl}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PanelGrabber" TargetType="Button">
            <Setter Property="Width" Value="72" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Border x:Name="Bar" Width="36" Height="5" CornerRadius="2.5" Background="#47FFFFFF" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bar" Property="Background" Value="#80FFFFFF" />
                                <Setter TargetName="Bar" Property="Width" Value="44" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- The notch's black shape, grown into the chat: flat against the top edge and the
         screen side, one rounded corner. Only this shape is drawn; the rest of the window is
         transparent (and click-through). -->
    <Grid>
        <Border x:Name="Panel" HorizontalAlignment="Right" VerticalAlignment="Top" Width="420" Height="760"
                Background="Black" BorderBrush="#5CFFFFFF" BorderThickness="1,0,0,1" CornerRadius="0,0,0,22" ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect BlurRadius="34" ShadowDepth="8" Direction="250" Opacity="0.35" Color="Black" />
            </Border.Effect>
            <Grid x:Name="PanelContent" Opacity="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="50" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header: logo · title / context · copy · widen · fold back -->
                <Grid Margin="14,0,10,0" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText" Text="Percakapan" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource PanelText}"
                                   TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="#30D158" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="ContextText" FontSize="11" Foreground="{StaticResource PanelText2}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="CopyButton" Style="{StaticResource PanelRoundButton}" Click="CopyButton_Click" ToolTip="Salin jawaban terakhir"
                                AutomationProperties.Name="Salin jawaban terakhir">
                            <Path Stroke="{StaticResource PanelText2}" StrokeThickness="1.5" StrokeLineJoin="Round"
                                  Data="M 4,4 L 4,1.5 Q 4,0.5 5,0.5 L 11,0.5 Q 12,0.5 12,1.5 L 12,8 Q 12,9 11,9 L 9,9 M 1,4 L 8,4 Q 9,4 9,5 L 9,11.5 Q 9,12.5 8,12.5 L 1,12.5 Q 0,12.5 0,11.5 L 0,5 Q 0,4 1,4 Z" />
                        </Button>
                        <Button x:Name="ExpandButton" Style="{StaticResource PanelRoundButton}" Click="ExpandButton_Click" ToolTip="Perlebar"
                                AutomationProperties.Name="Perlebar">
                            <Path Stroke="{StaticResource PanelText2}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Data="M 6,0.5 L 9.5,0.5 L 9.5,4 M 9.5,0.5 L 5.5,4.5 M 4,9.5 L 0.5,9.5 L 0.5,6 M 0.5,9.5 L 4.5,5.5" />
                        </Button>
                        <Button x:Name="CloseButton" Style="{StaticResource PanelRoundButton}" Click="CloseButton_Click" ToolTip="Kembali ke notch"
                                AutomationProperties.Name="Tutup">
                            <Path Stroke="{StaticResource PanelText2}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M 0,0 L 8,8 M 8,0 L 0,8" />
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="12,0,8,0">
                    <local:ConversationView x:Name="PanelConversation" AutomationProperties.Name="Percakapan" />
                    <Button x:Name="JumpLatestButton" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,8"
                            Height="28" Padding="12,0" Cursor="Hand" Click="JumpLatestButton_Click" AutomationProperties.Name="Lompat ke jawaban terbaru">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border CornerRadius="14" Background="White" Padding="{TemplateBinding Padding}">
                                    <TextBlock Text="↓ Terbaru" FontSize="12" Foreground="Black" VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- Composer, as in Claude Code: a framed text box with ↵ inside, and under it
                     "+" and the mic (left), model, effort and status (right). -->
                <StackPanel Grid.Row="3" Margin="12,8,12,0">
                    <WrapPanel x:Name="AttachmentChips" Margin="-2,0,0,8" Visibility="Collapsed" />
                    <Border x:Name="InputFrame" CornerRadius="10" BorderBrush="#33FFFFFF" BorderThickness="1" Background="#0DFFFFFF"
                            Padding="12,7,6,7" MinHeight="44">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="InputPlaceholder" Margin="2,0,0,0" Text="Tanya lanjutan…" Foreground="{StaticResource PanelText3}"
                                       VerticalAlignment="Center" IsHitTestVisible="False" />
                            <TextBox x:Name="Input" Margin="0" Padding="0" Background="Transparent" BorderThickness="0"
                                     Foreground="{StaticResource PanelText}" CaretBrush="White" VerticalAlignment="Center" TextWrapping="Wrap"
                                     AcceptsReturn="False" MaxHeight="160" VerticalScrollBarVisibility="Auto"
                                     TextChanged="Input_TextChanged" PreviewKeyDown="Input_PreviewKeyDown" AutomationProperties.Name="Tanya lanjutan" />
                            <Button x:Name="SendButton" Grid.Column="1" Style="{StaticResource PanelSendButton}" VerticalAlignment="Bottom" Margin="6,0,0,0"
                                    Click="SendButton_Click" IsEnabled="False" AutomationProperties.Name="Kirim">
                                <Grid>
                                    <Path x:Name="SendGlyph" Stroke="{StaticResource PanelText2}" StrokeThickness="1.5" StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M 11,1 L 11,6 Q 11,8.5 8.5,8.5 L 1,8.5 M 4,5.5 L 1,8.5 L 4,11.5" />
                                    <Border x:Name="StopGlyph" Width="9" Height="9" CornerRadius="2" Background="White" Visibility="Collapsed" />
                                </Grid>
                            </Button>
                        </Grid>
                    </Border>

                    <Grid Margin="0,6,2,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <Button x:Name="AttachButton" Style="{StaticResource PanelRoundButton}" Width="26" Height="26"
                                    Click="AttachButton_Click" ToolTip="Lampirkan file atau gambar (atau tempel dengan Ctrl+V)" AutomationProperties.Name="Lampirkan file">
                                <Path Stroke="{StaticResource PanelText2}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 5.5,0 L 5.5,11 M 0,5.5 L 11,5.5" />
                            </Button>
                            <Button x:Name="MicButton" Style="{StaticResource PanelRoundButton}" Width="26" Height="26" Margin="2,0,0,0"
                                    Click="MicButton_Click" ToolTip="Dikte dengan suara (klik lagi untuk selesai)" AutomationProperties.Name="Dikte">
                                <Path x:Name="MicGlyph" Stroke="{StaticResource PanelText2}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" Data="M 4,1.5 Q 4,0 5.5,0 Q 7,0 7,1.5 L 7,6 Q 7,7.5 5.5,7.5 Q 4,7.5 4,6 Z M 1.5,5 Q 1.5,9.5 5.5,9.5 Q 9.5,9.5 9.5,5 M 5.5,9.5 L 5.5,12" />
                            </Button>
                            <TextBlock x:Name="ModeText" Margin="8,0,0,1" FontSize="12.5" Foreground="#E8A15B" VerticalAlignment="Center"
                                       ToolTip="Mode persetujuan (ubah di Pengaturan)" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock x:Name="ModelText" FontSize="12.5" Foreground="{StaticResource PanelText}" VerticalAlignment="Center" Margin="0,0,12,1" />
                            <TextBlock x:Name="EffortText" FontSize="12.5" Foreground="{StaticResource PanelText}" VerticalAlignment="Center" Margin="0,0,12,1" />
                            <Grid Width="14" Height="14" VerticalAlignment="Center" ToolTip="Status">
                                <Ellipse Stroke="#33FFFFFF" StrokeThickness="2" />
                                <Path x:Name="BusyArc" Stroke="#0A84FF" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Data="M 7,1 A 6,6 0 0 1 13,7" RenderTransformOrigin="0.5,0.5" Visibility="Collapsed">
                                    <Path.RenderTransform>
                                        <RotateTransform x:Name="BusyRotate" />
                                    </Path.RenderTransform>
                                </Path>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <Button x:Name="Grabber" Grid.Row="4" Style="{StaticResource PanelGrabber}" HorizontalAlignment="Center" Margin="0,8,0,8"
                        Click="CloseButton_Click" ToolTip="Kembali ke notch" AutomationProperties.Name="Kembali ke notch" />

                <!-- Drag the inner edge to set the width. -->
                <Border x:Name="ResizeGrip" Grid.RowSpan="5" Width="6" HorizontalAlignment="Left" Background="Transparent" Cursor="SizeWE"
                        MouseLeftButtonDown="ResizeGrip_MouseLeftButtonDown" MouseMove="ResizeGrip_MouseMove"
                        MouseLeftButtonUp="ResizeGrip_MouseLeftButtonUp" ToolTip="Tarik untuk mengatur lebar" />
            </Grid>
        </Border>
    </Grid>
</Window>
