                                    <Grid Style="{StaticResource FluentRow}">
                                        <TextBlock Style="{StaticResource FluentRowLabel}" Text="{local:Tr Log diagnostik, En=Diagnostics log}" />
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Style="{StaticResource FluentButton}" Content="{local:Tr Buka folder, En=Open folder}" Margin="0,0,12,0" Click="OpenLogs_Click" />
                                            <CheckBox x:Name="DiagnosticsSwitch" Style="{StaticResource FluentSwitch}" Click="Setting_Changed" />
                                        </StackPanel>
                                    </Grid>
                                    <Border Style="{StaticResource FluentSeparator}" />
                                    <Grid Style="{StaticResource FluentRow}">
                                        <TextBlock Style="{StaticResource FluentRowLabel}" Text="{local:Tr Template prompt, En=Prompt templates}" />
                                        <Button Style="{StaticResource FluentButton}" HorizontalAlignment="Right" Content="{local:Tr Kelola…, En=Manage…}" Click="Templates_Click" />
                                    </Grid>
                                    <Border Style="{StaticResource FluentSeparator}" />
                                    <Grid Style="{StaticResource FluentRow}">
                                        <TextBlock Style="{StaticResource FluentRowLabel}" Text="{local:Tr File pengaturan, En=Settings file}" />
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Style="{StaticResource FluentButton}" Content="{local:Tr Ekspor…, En=Export…}" Margin="0,0,6,0" Click="Export_Click" />
                                            <Button Style="{StaticResource FluentButton}" Content="{local:Tr Impor…, En=Import…}" Click="Import_Click" />
                                        </StackPanel>
                                    </Grid>
                                    <Border Style="{StaticResource FluentSeparator}" />
                                    <Grid Style="{StaticResource FluentRow}">
                                        <TextBlock Style="{StaticResource FluentRowLabel}" Text="{local:Tr Laporan bug, En=Bug report}" />
                                        <Button Style="{StaticResource FluentButton}" HorizontalAlignment="Right" Content="{local:Tr Buat laporan…, En=Create report…}" Click="ReportBug_Click" />
                                    </Grid>
                                    <Border Style="{StaticResource FluentSeparator}" />
                                    <Grid Style="{StaticResource FluentRow}">
                                        <TextBlock Style="{StaticResource FluentRowLabel}" Text="{local:Tr Tata letak bar, En=Bar layout}" />
                                        <Button Style="{StaticResource FluentButton}" HorizontalAlignment="Right" Content="{local:Tr Atur ulang, En=Reset}" Click="ResetLayout_Click" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource FluentGroupBox}" Margin="0,18,0,0">
                                <StackPanel>
                                    <Grid Style="{StaticResource FluentRow}">
                                        <TextBlock Style="{StaticResource FluentRowLabel}" Text="{local:Tr Cek pembaruan otomatis, En=Check for updates}" />
                                        <CheckBox x:Name="UpdateSwitch" Style="{StaticResource FluentSwitch}" HorizontalAlignment="Right" Click="Setting_Changed" />
                                    </Grid>
                                    <Border Style="{StaticResource FluentSeparator}" />
                                    <Grid Style="{StaticResource FluentRow}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="190" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource FluentRowLabel}" Text="{local:Tr Repositori rilis, En=Release repository}" />
                                        <TextBox x:Name="UpdateRepositoryField" Grid.Column="1" Style="{StaticResource FluentField}" LostFocus="Setting_Changed" />
                                        <Button Grid.Column="2" Style="{StaticResource FluentButton}" Margin="8,0,0,0" Content="{local:Tr Cek sekarang, En=Check now}" Click="CheckUpdate_Click" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <TextBlock x:Name="UpdateStatusText" Style="{StaticResource FluentRowHint}" />
                            <TextBlock x:Name="VersionText" Style="{StaticResource FluentRowHint}" />
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </DockPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Style="{StaticResource FluentCaption}" Content="&#xE921;" Click="Minimize_Click" ToolTip="{local:Tr Kecilkan, En=Minimize}"
                        AutomationProperties.Name="{local:Tr Kecilkan, En=Minimize}" />
                <Button Style="{StaticResource FluentCaptionClose}" Click="Close_Click" ToolTip="{local:Tr Tutup, En=Close}"
                        AutomationProperties.Name="{local:Tr Tutup, En=Close}" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
