<Window x:Class="CodexBar.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CodexBar.App"
        Title="{local:Tr Pengaturan TheAI, En=TheAI Settings}"
        Width="960" Height="720"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14"
        Foreground="{DynamicResource FluentText}"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="FluentTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="NavItem" TargetType="RadioButton">
                <Setter Property="GroupName" Value="nav" />
                <Setter Property="Foreground" Value="{DynamicResource FluentText}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Margin" Value="0,0,0,2" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource FluentFocus}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Grid>
                                <Border x:Name="Bg" Height="40" CornerRadius="4" Padding="12,0" Background="Transparent">
                                    <ContentPresenter VerticalAlignment="Center" />
                                </Border>
                                <Border x:Name="Pill" Width="3" Height="16" CornerRadius="1.5" HorizontalAlignment="Left"
                                        Background="{DynamicResource FluentAccent}" Visibility="Collapsed" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource FluentHover}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource FluentFill}" />
                                    <Setter TargetName="Pill" Property="Visibility" Value="Visible" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="NavIcon" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="Width" Value="16" />
                <Setter Property="Margin" Value="0,0,12,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!-- Display-mode picker: miniature screens -->
            <Style x:Key="ModeCard" TargetType="RadioButton">
                <Setter Property="GroupName" Value="mode" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Margin" Value="11,0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <StackPanel>
                                <Border x:Name="Ring" CornerRadius="8" BorderThickness="2.5" BorderBrush="Transparent" Padding="0">
                                    <Border Width="88" Height="56" CornerRadius="6" Background="#B9C6D6" ClipToBounds="True"
                                            BorderBrush="#26000000" BorderThickness="0.5">
                                        <ContentPresenter />
                                    </Border>
                                </Border>
                                <TextBlock x:Name="Label" Text="{TemplateBinding Tag}" FontSize="12" Foreground="{DynamicResource FluentText2}"
                                           HorizontalAlignment="Center" Margin="0,6,0,0" />
                            </StackPanel>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource FluentAccent}" />
                                    <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource FluentText}" />
                                    <Setter TargetName="Label" Property="FontWeight" Value="SemiBold" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border Margin="22" CornerRadius="8" Background="{DynamicResource FluentWindow}" BorderBrush="{DynamicResource FluentEdge}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="8" Direction="270" Opacity="0.28" />
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="248" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Background="Transparent" MouseLeftButtonDown="DragArea_MouseLeftButtonDown">
                <DockPanel Margin="12,16,4,16" LastChildFill="True">
                    <Button DockPanel.Dock="Top" Margin="0,0,0,12" Click="AccountCard_Click" Cursor="Hand" Foreground="{DynamicResource FluentText}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bg" CornerRadius="4" Padding="8,6" Background="Transparent">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bg" Property="Background" Value="{DynamicResource FluentHover}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="32" Height="32" Margin="0,0,12,0">
                                <Border CornerRadius="8" Background="Black" BorderBrush="{DynamicResource FluentLine}" BorderThickness="1" />
                                <Border Width="14" Height="5" CornerRadius="0,0,3,3" Background="White" VerticalAlignment="Top" />
                            </Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="AccountName" Text="Codex" FontWeight="SemiBold" />
                                <TextBlock x:Name="AccountStatus" Text="…" FontSize="12" Foreground="{DynamicResource FluentText2}" />
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <Border DockPanel.Dock="Top" Height="32" CornerRadius="4" Background="{DynamicResource FluentControl}" BorderBrush="{DynamicResource FluentControlLine}" BorderThickness="1"
                            Padding="10,0" Margin="4,0,4,12" SnapsToDevicePixels="True">
                        <Grid>
                            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Text="&#xE721;" Foreground="{DynamicResource FluentText2}"
                                       HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" />
                            <TextBlock x:Name="SearchPlaceholder" Text="{local:Tr Cari, En=Search}" Margin="24,0,0,0" Foreground="{DynamicResource FluentText2}"
                                       VerticalAlignment="Center" IsHitTestVisible="False" />
                            <TextBox x:Name="SearchBox" Margin="22,0,0,0" Background="Transparent" BorderThickness="0" VerticalAlignment="Center"
                                     Foreground="{DynamicResource FluentText}" CaretBrush="{DynamicResource FluentText}"
                                     TextChanged="SearchBox_TextChanged" AutomationProperties.Name="{local:Tr Cari pengaturan, En=Search settings}" />
                        </Grid>
                    </Border>

                    <StackPanel>
                        <RadioButton x:Name="NavGeneral" Style="{StaticResource NavItem}" Tag="general" Checked="Nav_Checked" IsChecked="True">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource NavIcon}" Text="&#xE713;" />
                                <TextBlock Text="{local:Tr Umum, En=General}" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavAppearance" Style="{StaticResource NavItem}" Tag="appearance" Checked="Nav_Checked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource NavIcon}" Text="&#xE790;" />
                                <TextBlock Text="{local:Tr Tampilan, En=Appearance}" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="NavProvider" Style="{StaticResource NavItem}" Tag="provider" Checked="Nav_Checked" Margin="0,8,0,2">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource NavIcon}" Text="&#xE756;" />
                                <TextBlock Text="Provider" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavModel" Style="{StaticResource NavItem}" Tag="model" Checked="Nav_Checked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource NavIcon}" Text="&#xE9F5;" />
                                <TextBlock Text="Model" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavWorkspace" Style="{StaticResource NavItem}" Tag="workspace" Checked="Nav_Checked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource NavIcon}" Text="&#xE8B7;" />
                                <TextBlock Text="{local:Tr Workspace &amp; izin, En=Workspace &amp; permissions}" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="NavShortcuts" Style="{StaticResource NavItem}" Tag="shortcuts" Checked="Nav_Checked" Margin="0,8,0,2">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource NavIcon}" Text="&#xE92E;" />
                                <TextBlock Text="{local:Tr Pintasan, En=Shortcuts}" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavAdvanced" Style="{StaticResource NavItem}" Tag="advanced" Checked="Nav_Checked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource NavIcon}" Text="&#xE9E9;" />
                                <TextBlock Text="{local:Tr Lanjutan, En=Advanced}" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Content -->
            <DockPanel Grid.Column="1">
                <Grid DockPanel.Dock="Top" Height="88" Background="Transparent" MouseLeftButtonDown="DragArea_MouseLeftButtonDown">
                    <TextBlock x:Name="PageTitle" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="28" LineHeight="36" FontWeight="SemiBold" Margin="24,0,0,12" VerticalAlignment="Bottom" />
                </Grid>

                <ScrollViewer VerticalScrollBarVisibility="Visible" Padding="24,0,24,24">
                    <Grid>
                        <!-- Umum -->
                        <StackPanel x:Name="PageGeneral">
                            <Border Style="{StaticResource FluentGroupBox}">
                                <StackPanel>
                                    <Grid Style="{StaticResource FluentRow}">
                                        <TextBlock Style="{StaticResource FluentRowLabel}" Text="{local:Tr Bahasa, En=Language}" />
                                        <ComboBox x:Name="LanguagePopup" Style="{StaticResource FluentPopup}" SelectionChanged="Setting_Changed">
                                            <ComboBoxItem Content="{local:Tr Ikuti Windows, En=Same as Windows}" Tag="auto" />
                                            <ComboBoxItem Content="Indonesia" Tag="id" />
                                            <ComboBoxItem Content="English" Tag="en" />
                                        </ComboBox>
                                    </Grid>
                                    <Border Style="{StaticResource FluentSeparator}" />
                                    <Grid Style="{StaticResource FluentRow}">
                                        <TextBlock Style="{StaticResource FluentRowLabel}" Text="{local:Tr Tema, En=Theme}" />
                                        <ComboBox x:Name="ThemePopup" Style="{StaticResource FluentPopup}" SelectionChanged="Setting_Changed">
                                            <ComboBoxItem Content="{local:Tr Ikuti sistem, En=Match system}" Tag="system" />
                                            <ComboBoxItem Content="{local:Tr Terang, En=Light}" Tag="light" />
                                            <ComboBoxItem Content="{local:Tr Gelap, En=Dark}" Tag="dark" />
                                        </ComboBox>
                                    </Grid>
                                    <Border Style="{StaticResource FluentSeparator}" />
                                    <Grid Style="{StaticResource FluentRow}">
                                        <TextBlock Style="{StaticResource FluentRowLabel}" Text="{local:Tr Jalankan saat login Windows, En=Open at Windows sign-in}" />
                                        <CheckBox x:Name="LaunchAtLoginSwitch" Style="{StaticResource FluentSwitch}" HorizontalAlignment="Right" Click="Setting_Changed" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource FluentGroupBox}" Margin="0,18,0,0">
                                <StackPanel>
                                    <Grid Style="{StaticResource FluentRow}">
                                        <TextBlock Style="{StaticResource FluentRowLabel}" Text="{local:Tr Salin jawaban otomatis, En=Copy answers automatically}" />
                                        <CheckBox x:Name="AutoCopySwitch" Style="{StaticResource FluentSwitch}" HorizontalAlignment="Right" Click="Setting_Changed" />
                                    </Grid>
                                    <Border Style="{StaticResource FluentSeparator}" />
                                    <Grid Style="{StaticResource FluentRow}">
                                        <TextBlock Style="{StaticResource FluentRowLabel}" Text="{local:Tr Selalu di atas jendela lain, En=Keep above other windows}" />
                                        <CheckBox x:Name="AlwaysOnTopSwitch" Style="{StaticResource FluentSwitch}" HorizontalAlignment="Right" Click="Setting_Changed" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <TextBlock Style="{StaticResource FluentRowHint}" Text="{local:Tr Jawaban yang selesai langsung masuk clipboard. Selalu di atas berlaku untuk bar dan jendela percakapan., En=Finished answers go straight to the clipboard. Keep above applies to the bar and conversation window.}" />

                            <Border Style="{StaticResource FluentGroupBox}" Margin="0,18,0,0">
                                <StackPanel>
                                    <Grid Style="{StaticResource FluentRow}">
                                        <TextBlock Style="{StaticResource FluentRowLabel}" Text="{local:Tr Bunyi saat selesai, En=Sound when done}" />
                                        <CheckBox x:Name="CompletionSoundSwitch" Style="{StaticResource FluentSwitch}" HorizontalAlignment="Right" Click="Setting_Changed" />
                                    </Grid>
                                    <Border Style="{StaticResource FluentSeparator}" />
                                    <Grid Style="{StaticResource FluentRow}">
                                        <TextBlock Style="{StaticResource FluentRowLabel}" Text="{local:Tr Notifikasi saat selesai, En=Notify when done}" />
                                        <CheckBox x:Name="CompletionNotificationSwitch" Style="{StaticResource FluentSwitch}" HorizontalAlignment="Right" Click="Setting_Changed" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <TextBlock x:Name="NotifyHint" Style="{StaticResource FluentRowHint}" />

                            <Border Style="{StaticResource FluentGroupBox}" Margin="0,18,0,0">
                                <StackPanel>
                                    <Grid Style="{StaticResource FluentRow}">
                                        <TextBlock Style="{StaticResource FluentRowLabel}" Text="{local:Tr Tebak prompt berikutnya, En=Suggest the next prompt}" />
                                        <CheckBox x:Name="SuggestSwitch" Style="{StaticResource FluentSwitch}" HorizontalAlignment="Right" Click="Setting_Changed" />
                                    </Grid>
                                    <Border Style="{StaticResource FluentSeparator}" />
                                    <Grid Style="{StaticResource FluentRow}">
                                        <TextBlock Style="{StaticResource FluentRowLabel}"
                                                   Text="{local:Tr Fork otomatis jika sesi terbuka di Claude Code, En=Fork automatically when the session is open in Claude Code}" />
                                        <CheckBox x:Name="AutoForkSwitch" Style="{StaticResource FluentSwitch}" HorizontalAlignment="Right" Click="Setting_Changed" />
                                    </Grid>
                                    <Border Style="{StaticResource FluentSeparator}" />
                                    <Grid Style="{StaticResource FluentRow}">
                                        <TextBlock Style="{StaticResource FluentRowLabel}" Text="{local:Tr Sumber tebakan, En=Suggestions from}" />
                                        <ComboBox x:Name="SuggestSourcePopup" Style="{StaticResource FluentPopup}" SelectionChanged="Setting_Changed">
                                            <ComboBoxItem x:Name="SuggestHabitItem" Tag="habit" />
                                            <ComboBoxItem x:Name="SuggestAiItem" Tag="habit+ai" />
                                        </ComboBox>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <TextBlock x:Name="SuggestHint" Style="{StaticResource FluentRowHint}" />

                            <Border Style="{StaticResource FluentGroupBox}" Margin="0,18,0,0">
                                <StackPanel>
                                    <Grid Style="{StaticResource FluentRow}">
                                        <TextBlock Style="{StaticResource FluentRowLabel}" Text="{local:Tr Bahasa ucapan, En=Spoken language}" />
                                        <ComboBox x:Name="VoiceLanguagePopup" Style="{StaticResource FluentPopup}" SelectionChanged="Setting_Changed">
                                            <ComboBoxItem Content="Indonesia" Tag="id" />
                                            <ComboBoxItem Content="English" Tag="en" />
                                            <ComboBoxItem Content="{local:Tr Deteksi otomatis (lebih lambat), En=Detect automatically (slower)}" Tag="auto" />
                                        </ComboBox>
                                    </Grid>
                                    <Border Style="{StaticResource FluentSeparator}" />
                                    <Grid Style="{StaticResource FluentRow}">
                                        <TextBlock Style="{StaticResource FluentRowLabel}" Text="{local:Tr Model suara, En=Voice model}" />
                                        <ComboBox x:Name="VoiceModelPopup" Style="{StaticResource FluentPopup}" SelectionChanged="Setting_Changed">
                                            <ComboBoxItem x:Name="VoiceModelBase" Tag="base" />
                                            <ComboBoxItem x:Name="VoiceModelSmall" Tag="small" />
                                        </ComboBox>
                                    </Grid>
                                    <Border Style="{StaticResource FluentSeparator}" />
                                    <Grid Style="{StaticResource FluentRow}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource FluentRowLabel}" Text="{local:Tr Input suara, En=Voice input}" />
                                            <TextBlock x:Name="VoiceStatusText" FontSize="12" Foreground="{StaticResource FluentText2}" Margin="0,1,0,0" />
                                        </StackPanel>
                                        <Button x:Name="VoiceInstallButton" Grid.Column="1" Style="{StaticResource FluentButton}" Click="VoiceInstall_Click" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <TextBlock x:Name="VoiceHint" Style="{StaticResource FluentRowHint}" />
                        </StackPanel>

                        <!-- Tampilan -->
                        <StackPanel x:Name="PageAppearance" Visibility="Collapsed">
                            <Border Style="{StaticResource FluentGroupBox}" Padding="0,14,0,12">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <RadioButton x:Name="ModeNotch" Style="{StaticResource ModeCard}" Tag="Notch" Checked="Mode_Checked">
                                        <Grid>
                                            <Border Height="6" VerticalAlignment="Top" Background="#80FFFFFF" />
                                            <Border Width="26" Height="8" CornerRadius="0,0,4,4" Background="Black" VerticalAlignment="Top" />
                                        </Grid>
                                    </RadioButton>
                                    <RadioButton x:Name="ModeIsland" Style="{StaticResource ModeCard}" Tag="Dynamic Island" Checked="Mode_Checked">
                                        <Grid>
                                            <Border Height="6" VerticalAlignment="Top" Background="#80FFFFFF" />
                                            <Border Width="26" Height="8" CornerRadius="4" Background="Black" VerticalAlignment="Top" Margin="0,3,0,0" />
                                        </Grid>
                                    </RadioButton>
                                </StackPanel>
                            </Border>

                            <Border x:Name="NotchGroup" Style="{StaticResource FluentGroupBox}" Margin="0,18,0,0">
                                <StackPanel>
                                    <Grid Style="{StaticResource FluentRow}">
                                        <StackPanel VerticalAlignment="Center" Margin="0,6,120,6">
                                            <TextBlock Style="{StaticResource FluentRowLabel}" Text="{local:Tr Fitur notch, En=Notch features}" />
                                            <TextBlock FontSize="12" Foreground="{StaticResource FluentText2}" Margin="0,1,0,0" TextWrapping="Wrap"
                                                       Text="{local:Tr Pilih apa saja yang tampil di notch, En=Choose everything the notch shows}" />
                                        </StackPanel>
                                        <Button Style="{StaticResource FluentButton}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                Content="{local:Tr Pilih fitur…, En=Choose features…}" Click="Features_Click" />
                                    </Grid>
                                    <Border Style="{StaticResource FluentSeparator}" />
                                    <Grid Style="{StaticResource FluentRow}">
                                        <StackPanel VerticalAlignment="Center" Margin="0,6,60,6">
                                            <TextBlock Style="{StaticResource FluentRowLabel}" Text="{local:Tr Gabungkan halaman harian, En=Combine the day pages}" />
                                            <TextBlock FontSize="12" Foreground="{StaticResource FluentText2}" Margin="0,1,0,0" TextWrapping="Wrap"
                                                       Text="{local:Tr Cuaca dan rapat dan air dan pengingat dalam satu halaman Hari ini, En=Weather and meetings and water and reminders on one Today page}" />
                                        </StackPanel>
                                        <CheckBox x:Name="CombinedPagesSwitch" Style="{StaticResource FluentSwitch}" HorizontalAlignment="Right" Click="Setting_Changed"
                                                  AutomationProperties.Name="Gabungkan halaman harian" />
                                    </Grid>
                                    <Border Style="{StaticResource FluentSeparator}" />
                                    <Grid Style="{StaticResource FluentRow}">
                                        <TextBlock Style="{StaticResource FluentRowLabel}" Text="{local:Tr Sembunyikan notch saat diam, En=Hide the notch when idle}" />
                                        <CheckBox x:Name="HideIdleSwitch" Style="{StaticResource FluentSwitch}" HorizontalAlignment="Right" Click="Setting_Changed" />
                                    </Grid>
                                    <Border Style="{StaticResource FluentSeparator}" />
                                    <Grid Style="{StaticResource FluentRow}">
                                        <TextBlock Style="{StaticResource FluentRowLabel}" Text="{local:Tr Sembunyikan saat layar penuh (game / video), En=Hide in fullscreen (games / video)}" />
                                        <CheckBox x:Name="FullscreenSwitch" Style="{StaticResource FluentSwitch}" HorizontalAlignment="Right" Click="Setting_Changed" />
                                    </Grid>
                                    <Border Style="{StaticResource FluentSeparator}" />
                                    <Grid Style="{StaticResource FluentRow}">
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,60,0">
                                            <TextBlock Style="{StaticResource FluentRowLabel}" Text="{local:Tr Tahan agent selama fokus &amp; rapat, En=Hold agents during focus &amp; meetings}" />
                                            <TextBlock FontSize="12" Foreground="{StaticResource FluentText2}" Margin="0,1,0,0" TextWrapping="Wrap"
                                                       Text="{local:Tr Hasil dan permintaan izin muncul sekaligus saat istirahat, En=Results and permission requests show up together at the break}" />
                                        </StackPanel>
                                        <CheckBox x:Name="HoldFocusSwitch" Style="{StaticResource FluentSwitch}" HorizontalAlignment="Right" Click="Setting_Changed" />
                                    </Grid>
                                    <Border Style="{StaticResource FluentSeparator}" />
                                    <Grid Style="{StaticResource FluentRow}">
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,60,0">
                                            <TextBlock Style="{StaticResource FluentRowLabel}" Text="{local:Tr Aktivitas dari skrip, En=Activities from scripts}" />
                                            <TextBlock x:Name="LiveActivitiesHint" FontSize="12" Foreground="{StaticResource FluentText2}" Margin="0,1,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <CheckBox x:Name="LiveActivitiesSwitch" Style="{StaticResource FluentSwitch}" HorizontalAlignment="Right" Click="Setting_Changed" />
                                    </Grid>
                                    <Border Style="{StaticResource FluentSeparator}" />
                                    <Grid Style="{StaticResource FluentRow}">
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,60,0">
                                            <TextBlock Style="{StaticResource FluentRowLabel}" Text="{local:Tr Perintah terminal yang lama di notch, En=Long terminal commands in the notch}" />
                                            <TextBlock x:Name="ShellStatus" FontSize="12" Foreground="{StaticResource FluentText2}" Margin="0,1,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <CheckBox x:Name="ShellSwitch" Style="{StaticResource FluentSwitch}" HorizontalAlignment="Right" Click="Shell_Click" />
                                    </Grid>
                                    <Border Style="{StaticResource FluentSeparator}" />
                                    <Grid Style="{StaticResource FluentRow}">
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,60,0">
                                            <TextBlock Style="{StaticResource FluentRowLabel}" Text="{local:Tr CI pull request di notch, En=Pull request CI in the notch}" />
                                            <TextBlock FontSize="12" Foreground="{StaticResource FluentText2}" Margin="0,1,0,0" TextWrapping="Wrap"
                                                       Text="{local:Tr Lewat GitHub CLI (gh) yang sudah login — tanpa token baru, En=Through the signed-in GitHub CLI (gh) — no new token}" />
                                        </StackPanel>
                                        <CheckBox x:Name="GitHubSwitch" Style="{StaticResource FluentSwitch}" HorizontalAlignment="Right" Click="Setting_Changed" />
                                    </Grid>
                                    <Border Style="{StaticResource FluentSeparator}" />
                                    <Grid Style="{StaticResource FluentRow}">
                                        <TextBlock Style="{StaticResource FluentRowLabel}" Text="{local:Tr Rekap hari ini muncul jam 17.00, En=Show a recap of the day at 5 pm}" />
                                        <CheckBox x:Name="RecapSwitch" Style="{StaticResource FluentSwitch}" HorizontalAlignment="Right" Click="Setting_Changed" />
                                    </Grid>
                                    <Border Style="{StaticResource FluentSeparator}" />
                                    <Grid Style="{StaticResource FluentRow}">
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,60,0">
                                            <TextBlock Style="{StaticResource FluentRowLabel}" Text="{local:Tr Riwayat clipboard di notch, En=Clipboard history in the notch}" />
                                            <TextBlock FontSize="12" Foreground="{StaticResource FluentText2}" Margin="0,1,0,0" TextWrapping="Wrap"
                                                       Text="{local:Tr Hanya di memori — yang disalin password manager dilewati, En=Memory only — password manager copies are skipped}" />
                                        </StackPanel>
                                        <CheckBox x:Name="ClipboardSwitch" Style="{StaticResource FluentSwitch}" HorizontalAlignment="Right" Click="Setting_Changed" />
                                    </Grid>
                                    <Border Style="{StaticResource FluentSeparator}" />
                                    <Grid Style="{StaticResource FluentRow}">
                                        <TextBlock Style="{StaticResource FluentRowLabel}" Text="{local:Tr Unduhan masuk rak file (2 jam), En=Downloads go on the shelf (2 hours)}" />
                                        <CheckBox x:Name="DownloadsSwitch" Style="{StaticResource FluentSwitch}" HorizontalAlignment="Right" Click="Setting_Changed" />
                                    </Grid>
                                    <Border Style="{StaticResource FluentSeparator}" />
                                    <Grid Style="{StaticResource FluentRow}">
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,60,0">
                                            <TextBlock Style="{StaticResource FluentRowLabel}" Text="{local:Tr Monitor sistem, En=System monitor}" />
                                            <TextBlock FontSize="12" Foreground="{StaticResource FluentText2}" Margin="0,1,0,0" TextWrapping="Wrap"
                                                       Text="{local:Tr Halaman CPU / GPU / RAM / disk dan peringatan saat RAM atau C: hampir penuh, En=A CPU / GPU / RAM / disk page and a warning when memory or C: runs short}" />
                                        </StackPanel>
                                        <CheckBox x:Name="SystemMonitorSwitch" Style="{StaticResource FluentSwitch}" HorizontalAlignment="Right" Click="Setting_Changed" />
                                    </Grid>
                                    <Border Style="{StaticResource FluentSeparator}" />
                                    <Grid Style="{StaticResource FluentRow}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="240" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,6,12,6">
                                            <TextBlock Style="{StaticResource FluentRowLabel}" Text="{local:Tr Kota untuk cuaca, En=City for the weather}" />
                                            <TextBlock FontSize="12" Foreground="{StaticResource FluentText2}" Margin="0,1,0,0" TextWrapping="Wrap"
                                                       Text="{local:Tr Lewat Open-Meteo: hanya nama kota yang dikirim, En=Through Open-Meteo: only the city name is sent}" />
                                        </StackPanel>
