<Window x:Class="CodexBar.App.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CodexBar.App"
        Title="TheAI"
        Width="516" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Topmost="True"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14" Foreground="{DynamicResource FluentText}"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="FluentTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border Margin="22" CornerRadius="8" Background="{DynamicResource FluentWindow}" BorderBrush="{DynamicResource FluentEdge}" BorderThickness="1"
            MouseLeftButtonDown="Window_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="8" Direction="270" Opacity="0.28" />
        </Border.Effect>
        <Grid>
        <StackPanel Margin="24">
            <TextBlock x:Name="TitleText" Margin="0,0,40,0" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="20" LineHeight="28" FontWeight="SemiBold" />
            <TextBlock x:Name="BodyText" Margin="0,4,0,0" FontSize="14" Foreground="{DynamicResource FluentText2}" TextWrapping="Wrap" LineHeight="20" />

            <Border Style="{StaticResource FluentGroupBox}" Margin="0,16,0,0">
                <ItemsControl x:Name="StatusList" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <Border Style="{StaticResource FluentSeparator}" Visibility="{Binding SeparatorVisibility}" />
                                <Grid MinHeight="48" Margin="16,0">
                                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Value}" Foreground="{DynamicResource FluentText2}" Margin="0,0,7,0" VerticalAlignment="Center" />
                                        <Grid Width="13" Height="13" VerticalAlignment="Center">
                                            <Ellipse Fill="{Binding Dot}" />
                                            <Path Visibility="{Binding CheckVisibility}" Stroke="White" StrokeThickness="1.8"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                  Data="M 3.8,6.8 L 5.7,8.7 L 9.3,4.6" />
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <Grid x:Name="CommandRow" Margin="16,8,16,0">
                <TextBlock FontSize="12" Foreground="{DynamicResource FluentText2}" VerticalAlignment="Center">
                    <Run x:Name="CommandLead" />
                    <Run x:Name="CommandText" FontFamily="Cascadia Mono, Consolas" Foreground="{DynamicResource FluentText}" />
                </TextBlock>
                <Button x:Name="CopyButton" Style="{StaticResource FluentLinkButton}" HorizontalAlignment="Right" FontSize="12" Click="Copy_Click" />
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="16,12,16,0">
                <Button x:Name="LinkButton" Style="{StaticResource FluentLinkButton}" Margin="0,0,16,0" Click="Link_Click" />
                <Button x:Name="SkipButton" Style="{StaticResource FluentLinkButton}" Click="Later_Click" />
            </StackPanel>

            <Grid Margin="0,24,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="SecondaryButton" Style="{StaticResource FluentButton}" Margin="0,0,8,0" Click="Secondary_Click" />
                    <Button x:Name="PrimaryButton" Style="{StaticResource FluentPrimaryButton}" Click="Primary_Click" IsDefault="True" />
                </StackPanel>
            </Grid>
        </StackPanel>
        <Button x:Name="CloseCaption" Style="{StaticResource FluentCaptionClose}" HorizontalAlignment="Right" VerticalAlignment="Top" Click="Later_Click" />
        </Grid>
    </Border>
</Window>
