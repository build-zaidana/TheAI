    <SolidColorBrush x:Key="FluentFill" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="FluentHover" Color="#0CFFFFFF" />
    <SolidColorBrush x:Key="FluentThumb" Color="#47FFFFFF" />
    <SolidColorBrush x:Key="FluentText" Color="#F5F5F7" />
    <SolidColorBrush x:Key="FluentText2" Color="#A1A1A8" />
    <SolidColorBrush x:Key="FluentAccent" Color="#F5F5F7" />
    <SolidColorBrush x:Key="FluentOnAccent" Color="#000000" />
