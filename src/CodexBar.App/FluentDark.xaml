    <SolidColorBrush x:Key="FluentGroup" Color="#1E1E21" />
    <SolidColorBrush x:Key="FluentControl" Color="#26262A" />
    <SolidColorBrush x:Key="FluentMenu" Color="#26262A" />
    <SolidColorBrush x:Key="FluentEdge" Color="#29FFFFFF" />
    <SolidColorBrush x:Key="FluentLine" Color="#14FFFFFF" />
